        r = list_services(); print(f"\n{len(r)} services found:"); print("\n".join(r))
        sys.exit(0)
    if len(sys.argv) == 2 and sys.argv[1] in ("install", "uninstall"):
        err = install_menu() if sys.argv[1] == "install" else uninstall_menu()
        print(err or ("Added to the app menu" if sys.argv[1] == "install" else "Removed from the app menu"))
