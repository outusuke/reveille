#!/usr/bin/env python3
"""Task Scheduler: a small GTK4/libadwaita front end for systemd user timers.

systemd is the only store: every task is a plain .timer (and, for apps and commands, a .service)
in ~/.config/systemd/user. Nothing else is kept on disk, and the timers never call this program.

  reveille              open the window
  reveille install      add it to the app menu (copies itself to ~/.local/share/reveille)
  reveille uninstall    remove it from the app menu
  reveille services     list what the service picker finds (for troubleshooting)
"""
import datetime, os, re, shlex, shutil, subprocess, sys, tempfile, threading, time

HOME = os.path.expanduser("~")
CONF = os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config")
UNITS = f"{CONF}/systemd/user"
SELF = os.path.realpath(__file__)
APPS = os.environ.get("XDG_DATA_HOME", f"{HOME}/.local/share")
INSTALLED = f"{APPS}/reveille/reveille"          # stable copy for the app-menu entry
DESKTOP = f"{APPS}/applications/io.github.reveille.desktop"
DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
TRIGGERS = ["Daily", "Weekly", "Monthly", "Every N min/hours", "At login", "Custom"]
TRIGGER_IDS = ["daily", "weekly", "monthly", "interval", "login", "custom"]
DEFAULT_TR = {"type": "daily", "hour": 3, "minute": 0, "days": ["Mon"], "dom": 1, "every": 30, "unit": "min", "expr": ""}

SCHEDULE_KEYS = ("OnCalendar", "OnBootSec", "OnStartupSec", "OnUnitActiveSec", "OnActiveSec", "OnUnitInactiveSec",
                 "Persistent", "RandomizedDelaySec")
ONLINE = "network-online.target"
BOOT_OK = {"enabled", "enabled-runtime", "indirect", "alias"}     # UnitFileState values that survive a restart


# ---------------------------------------------------------------- unit files
def esc(s):                       # "%" is special in unit files
    return s.replace("%", "%%")

def unesc(s):
    return s.replace("%%", "%")

def xesc(s):                      # in ExecStart "$" is special too
    return esc(s).replace("$", "$$")

def xunesc(s):
    return unesc(s.replace("$$", "$"))

def unit_path(unit):
    return os.path.realpath(f"{UNITS}/{unit}")

def read_text(path):
    try:
        with open(path) as f: return f.read()
    except OSError:
        return ""

def groups(text):
    """Split a unit file into logical lines: a line ending in a backslash continues on the next one."""
    out, cur = [], []
    for l in text.splitlines():
        cur.append(l)
        if not l.rstrip().endswith("\\"):
            out.append(cur); cur = []
    if cur: out.append(cur)
    return out

def joined(g):
    return " ".join((x.rstrip()[:-1] if i < len(g) - 1 else x).strip() for i, x in enumerate(g))

def read_unit(path):
    """{section: {key: [values]}} or None if the file can't be read."""
    try:
        with open(path) as f: text = f.read()
    except OSError:
        return None
    out, sect = {}, None
    for g in groups(text):
        st = joined(g).strip()
        if not st or st[0] in "#;": continue
        if st.startswith("["): sect = st.strip("[]"); out.setdefault(sect, {}); continue
        if sect is not None and "=" in st:
            k, v = st.split("=", 1); out[sect].setdefault(k.strip(), []).append(v.strip())
    return out

def merge_unit(text, spec):
    """Rewrite only the lines the editor manages and keep every other line, comment and section as it was.
    spec = {section: (managed keys, new lines, keep)}: lines of a managed key are dropped unless keep(key, value)
    says to keep that one, and the new lines go where the first dropped line was (or at the end of the section)."""
    out, sect, slot, end, seen = [], None, {}, {}, set()
    def close():
        if sect is not None:
            j = len(out)
            while j > 0 and not out[j - 1].strip(): j -= 1
            end[sect] = j
    for g in groups(text):
        st = joined(g).strip()
        if st.startswith("[") and "]" in st:
            close(); sect = st[1:st.index("]")]; seen.add(sect); out += g; continue
        if sect in spec and "=" in st and st[0] not in "#;":
            k, v = (x.strip() for x in st.split("=", 1))
            managed, _, keep = spec[sect]
            if k in managed and not keep(k, v):
                slot.setdefault(sect, len(out)); continue
        out += g
    close()
    ins = [(slot.get(s, end.get(s)), new) for s, (_, new, _) in spec.items() if new and s in seen]
    for i, lines in sorted(ins, key=lambda x: -x[0]): out[i:i] = lines
    for s, (_, new, _) in spec.items():
        if new and s not in seen: out += ([""] if out else []) + [f"[{s}]"] + new
    return "\n".join(out) + "\n"

def write_atomic(path, text):
    """Write a file so a crash or full disk never leaves a half-written unit. A symlink is followed: the file
    it points to is replaced, the link stays."""
    path = os.path.realpath(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".reveille-")
    try:
        with os.fdopen(fd, "w") as f: f.write(text)
        try: os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        except OSError: os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try: os.unlink(tmp)
        except OSError: pass
        raise

SPAN_UNITS = {"us": 1e-6, "usec": 1e-6, "ms": 1e-3, "msec": 1e-3, "": 1, "s": 1, "sec": 1, "second": 1, "seconds": 1,
              "m": 60, "min": 60, "minute": 60, "minutes": 60, "h": 3600, "hr": 3600, "hour": 3600, "hours": 3600,
              "d": 86400, "day": 86400, "days": 86400, "w": 604800, "week": 604800, "weeks": 604800}

def parse_span(text):
    """A systemd time span (\"90\", \"5min\", \"1h 30min\") as whole seconds, or None if it isn't one."""
    text = text.strip()
    if not re.fullmatch(r"(?:\d+\s*[a-z]*\s*)+", text): return None
    total = 0
    for n, u in re.findall(r"(\d+)\s*([a-z]*)", text):
        if u not in SPAN_UNITS: return None
        total += int(n) * SPAN_UNITS[u]
    return int(total)

def parse_span_f(text):
    """Like parse_span, for the fractional spans systemctl prints ("1h 2min 3.5s"): seconds as a float, or None."""
    text = text.strip()
    if not re.fullmatch(r"(?:\d+(?:\.\d+)?\s*[a-z]*\s*)+", text): return None
    total = 0.0
    for n, u in re.findall(r"(\d+(?:\.\d+)?)\s*([a-z]*)", text):
        if u not in SPAN_UNITS: return None
        total += float(n) * SPAN_UNITS[u]
    return total

def parse_ts(text):
    """A timestamp as systemctl prints it ("Tue 2026-11-10 03:00:00 -03", local time) as epoch seconds, or None."""
    m = re.search(r"(\d{4})-(\d\d)-(\d\d) (\d\d):(\d\d):(\d\d)", text or "")
    return time.mktime((*map(int, m.groups()), 0, 0, -1)) if m else None

def next_run_epoch(kv, now=None, mono=None):
    """When a timer fires next, from its properties. Calendar timers carry a wall-clock time; interval and login
    timers only a monotonic one, which is turned into wall-clock time with the same clock Python uses."""
    t = parse_ts(kv.get("NextElapseUSecRealtime", ""))
    if t: return t
    span = parse_span_f(kv.get("NextElapseUSecMonotonic", ""))
    if not span: return None                    # 0, "infinity" or unreadable: nothing is scheduled
    now = time.time() if now is None else now
    mono = time.monotonic() if mono is None else mono
    return now + (span - mono)

def relative(epoch, now=None):
    """A moment as people say it: "in 12 min", "tomorrow 03:00", "yesterday 03:00", "3 days ago"."""
    now = time.time() if now is None else now
    d = epoch - now; a = abs(d); fut = d > 0
    if a < 60: return "in less than a minute" if fut else "just now"
    if a < 3600: n = round(a / 60); return f"in {n} min" if fut else f"{n} min ago"
    days = (datetime.date.fromtimestamp(epoch) - datetime.date.fromtimestamp(now)).days
    clock = time.strftime("%H:%M", time.localtime(epoch))
    if days == 0 and a < 6 * 3600:
        h, m = divmod(round(a / 60), 60); span = f"{h} h" + (f" {m} min" if m else "")
        return f"in {span}" if fut else f"{span} ago"
    if days == 0: return f"today {clock}"
    if days == 1: return f"tomorrow {clock}"
    if days == -1: return f"yesterday {clock}"
    if -7 < days < 0: return f"{-days} days ago"
    return time.strftime("%a %d %b %H:%M", time.localtime(epoch))

def ctl(*a):
    return subprocess.run(["systemctl", "--user", *a], capture_output=True, text=True)

def props(unit, *names):
    r = ctl("show", unit, *[x for n in names for x in ("-p", n)])
    return dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)

def show_many(units, *names):
    """One `systemctl show` for many units instead of one process each: {unit: {property: value}}."""
    if not units: return {}
    r = ctl("show", *units, *[x for n in ("Id",) + names for x in ("-p", n)])
    out = {}
    for block in r.stdout.split("\n\n"):
        kv = dict(l.split("=", 1) for l in block.splitlines() if "=" in l)
        if "Id" in kv: out[kv["Id"]] = kv
    return out

def unit_status(unit):
    """(next run text or "", is_active) for a timer unit"""
    kv = props(unit, "ActiveState", "NextElapseUSecRealtime")
    return kv.get("NextElapseUSecRealtime", "").strip(), kv.get("ActiveState") == "active"

def last_run_from(kv):
    if not kv.get("ExecMainExitTimestamp"): return None
    rc = 0 if kv.get("Result") == "success" else (int(kv.get("ExecMainStatus") or 0) or 1)
    return {"time": kv["ExecMainExitTimestamp"], "rc": rc}

def last_run(service):
    """Last result of a service, straight from systemd: {"time", "rc"} or None."""
    return last_run_from(props(service, "Result", "ExecMainStatus", "ExecMainExitTimestamp"))


# ---------------------------------------------------------------- schedules
def on_calendar(tr):
    h, m = int(tr.get("hour", 0)), int(tr.get("minute", 0))
    t = tr["type"]
    if t == "daily":
        return f"*-*-* {h:02d}:{m:02d}:00"
    if t == "weekly":
        days = ",".join(d for d in DAYS if d in tr.get("days", []))
        return f"{days} *-*-* {h:02d}:{m:02d}:00"
    if t == "monthly":
        return f"*-*-{int(tr.get('dom', 1)):02d} {h:02d}:{m:02d}:00"
    if t == "custom":
        return tr.get("expr", "").strip() or None
    return None

def describe(tr):
    t, hm = tr["type"], f"{int(tr.get('hour', 0)):02d}:{int(tr.get('minute', 0)):02d}"
    if t == "daily": return f"Every day at {hm}"
    if t == "weekly": return f"{', '.join(d for d in DAYS if d in tr.get('days', []))} at {hm}"
    if t == "monthly": return f"Day {tr.get('dom', 1)} of every month at {hm}"
    if t == "custom": return tr.get("expr", "custom schedule")
    if t == "interval": return f"Every {tr.get('every', 1)} {'hours' if tr.get('unit') == 'h' else 'minutes'}"
    return "At login"

def calendar_parts(expr):
    """A custom schedule may hold several calendar expressions separated by | (one OnCalendar= line each)."""
    return [p.strip() for p in expr.split("|") if p.strip()]

def next_elapse(tr):
    """Text for the live preview in the editor."""
    cal = on_calendar(tr)
    if cal:
        res = []
        for part in calendar_parts(cal):
            try:
                out = subprocess.run(["systemd-analyze", "calendar", part], capture_output=True, text=True, timeout=5).stdout
            except (OSError, subprocess.TimeoutExpired):
                return "Preview unavailable"
            nxt = re.search(r"Next elapse:\s*(.+)", out)
            left = re.search(r"From now:\s*(.+)", out)
            if not nxt: return "Not a valid schedule"
            res.append(nxt.group(1).strip() + (f"  ({left.group(1).strip()})" if left else ""))
        return "\n".join(res) if res else "Not a valid schedule"
    if tr["type"] == "interval":
        return f"First run {tr['every']} {'h' if tr['unit'] == 'h' else 'min'} after login, then repeats"
    return "Shortly after you log in"

def timer_lines(tr, catchup, delay):
    out, cal = [], on_calendar(tr)
    if cal:
        out += [f"OnCalendar={p}" for p in calendar_parts(cal)]
        if catchup: out.append("Persistent=true")
    elif tr["type"] == "interval":
        step = f"{int(tr['every'])}{'h' if tr['unit'] == 'h' else 'min'}"
        out += [f"OnStartupSec={step}", f"OnUnitActiveSec={step}"]
    else:
        out.append("OnStartupSec=10s")
    if delay: out.append(f"RandomizedDelaySec={int(delay)}")
    return out

def from_calendar(expr):
    e, hm = expr.strip(), r"(\d\d?):(\d\d)(?::00)?"
    if e == "daily": return {"type": "daily", "hour": 0, "minute": 0}
    m = re.fullmatch(rf"\*-\*-\* {hm}", e)
    if m: return {"type": "daily", "hour": int(m[1]), "minute": int(m[2])}
    m = re.fullmatch(rf"((?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)(?:,(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun))*) \*-\*-\* {hm}", e)
    if m: return {"type": "weekly", "days": m[1].split(","), "hour": int(m[2]), "minute": int(m[3])}
    m = re.fullmatch(rf"\*-\*-(\d\d?) {hm}", e)
    if m and 1 <= int(m[1]) <= 28: return {"type": "monthly", "dom": int(m[1]), "hour": int(m[2]), "minute": int(m[3])}
    return {"type": "custom", "expr": e}

def parse_schedule(kv):
    """Read the [Timer] keys as (trigger, catchup, delay), or None if they use something the editor would lose."""
    if any(k in kv for k in ("OnActiveSec", "OnUnitInactiveSec")): return None
    catchup = kv.get("Persistent", ["false"])[-1].lower() in ("true", "yes", "1", "on")
    delay = 0
    if "RandomizedDelaySec" in kv:
        delay = parse_span(kv["RandomizedDelaySec"][-1])
        if delay is None: return None
    cals, start = kv.get("OnCalendar", []), kv.get("OnStartupSec", []) + kv.get("OnBootSec", [])
    active = kv.get("OnUnitActiveSec", [])
    if len(cals) == 1 and not start and not active:
        tr = from_calendar(cals[0])
    elif len(cals) > 1 and not start and not active:
        tr = {"type": "custom", "expr": " | ".join(cals)}
    elif not cals and len(active) == 1 and len(start) <= 1:
        m = re.fullmatch(r"(\d+)\s*(min|m|minutes?|h|hr|hours?)", active[0])
        if not m or (start and start[0] != active[0]): return None
        tr = {"type": "interval", "every": int(m[1]), "unit": "h" if m[2][0] == "h" else "min"}
    elif not cals and not active and len(start) == 1 and re.fullmatch(r"\d+\s*s(ec)?", start[0]):
        tr = {"type": "login"}
    else:
        return None
    return {**DEFAULT_TR, **tr}, catchup, delay

def rewrite_timer(unit, tr, catchup, delay):
    """Replace only the schedule lines of a hand-written timer; everything else in the file is kept."""
    path = unit_path(unit)
    try:
        with open(path) as f: text = f.read()
        if not os.path.exists(path + ".reveille-bak"):          # one-time backup of the original
            write_atomic(path + ".reveille-bak", text)
        write_atomic(path, merge_unit(text, {"Timer": (set(SCHEDULE_KEYS), timer_lines(tr, catchup, delay),
                                                       lambda k, v: False)}))
    except OSError as e:
        return e.strerror or str(e)
    ctl("daemon-reload")
    if unit_status(unit)[1]: ctl("restart", unit)
    return None


# ---------------------------------------------------------------- tasks, read from the units themselves
def build_exec(t):
    """The ExecStart= value for an app or command task. Raises ValueError with a readable reason."""
    if t["kind"] == "app":
        from gi.repository import Gio
        info = Gio.DesktopAppInfo.new(t["app"])
        path = info.get_filename() if info else None
        if not path: raise ValueError(f"{t['app']} is not installed")
        gio, gtk = shutil.which("gio"), shutil.which("gtk-launch")
        if gio: tokens = [gio, "launch", path]
        elif gtk: tokens = [gtk, t["app"]]
        else: raise ValueError("Neither gio nor gtk-launch was found")
    else:
        tokens = shlex.split(t["command"])
        if not tokens: raise ValueError("Enter a valid command")
        if not os.path.isabs(tokens[0]):
            found = shutil.which(tokens[0])
            if not found: raise ValueError(f"{tokens[0]} was not found in PATH")
            tokens[0] = found
    return " ".join(xesc(shlex.quote(x)) for x in tokens)

def parse_service(name):
    """Read the settings the editor manages from a service file. Every other line is left alone when saving.
    Returns {"why": reason} if a managed setting is in a form the editor can't represent."""
    u = read_unit(unit_path(name))
    if u is None: return {"why": "the service file can't be read"}
    un, sv = u.get("Unit", {}), u.get("Service", {})
    if len(sv.get("ExecStart", [])) != 1: return {"why": "the service doesn't have exactly one ExecStart= line"}
    cmd = xunesc(sv["ExecStart"][0])
    if not cmd or cmd[0] in "-@:+!|": return {"why": "ExecStart= starts with a special prefix (- @ + ! :)"}
    try: tokens = shlex.split(cmd)
    except ValueError: return {"why": "ExecStart= can't be split into words"}
    deps = [x for v in un.get("Wants", []) + un.get("After", []) for x in v.split()]
    timeout = 0
    if "TimeoutStartSec" in sv:
        m = re.fullmatch(r"(\d+)min", sv["TimeoutStartSec"][-1])
        if not m: return {"why": "TimeoutStartSec= isn't a whole number of minutes"}
        timeout = int(m[1])
    env = []
    for v in sv.get("Environment", []):
        try: env += [unesc(x) for x in shlex.split(v)]
        except ValueError: return {"why": "Environment= has an unclosed quote"}
    adv = {"cwd": unesc(sv.get("WorkingDirectory", [""])[-1]), "env": " ".join(shlex.quote(x) for x in env),
           "timeout": timeout, "ac": "true" in un.get("ConditionACPower", []), "online": ONLINE in deps}
    s = {"adv": adv, "kind": "command", "command": cmd}
    if len(tokens) == 3 and os.path.basename(tokens[0]) == "gio" and tokens[1] == "launch":
        s.update(kind="app", app=os.path.basename(tokens[2]))
    elif len(tokens) == 2 and os.path.basename(tokens[0]) == "gtk-launch":
        s.update(kind="app", app=tokens[1] if tokens[1].endswith(".desktop") else tokens[1] + ".desktop")
    return s

def load_task(timer, status=None):
    """Build a task from a timer file (and the service it starts). "full" means the editor can rewrite it."""
    u = read_unit(unit_path(timer))
    if u is None: return None
    tk, base = u.get("Timer", {}), timer[:-6]
    target = (tk.get("Unit") or [base + ".service"])[0]
    sched = parse_schedule(tk)
    desc = unesc((u.get("Unit", {}).get("Description") or [""])[0])
    m = {"timer": timer, "unit": base, "service": target, "name": desc or base, "kind": "service", "full": False,
         "trigger": sched[0] if sched else None, "catchup": sched[1] if sched else True,
         "adv": {"delay": sched[2] if sched else 0},
         # "enabled" means the timer is active (will fire); "fstate" says whether it also survives a restart
         "enabled": (status[timer].get("ActiveState") == "active" if status is not None and timer in status
                     else unit_status(timer)[1]),
         "fstate": status[timer].get("UnitFileState", "") if status is not None and timer in status else ""}
    if not sched: return m
    if target == base + ".service" and os.path.isfile(f"{UNITS}/{target}"):
        s = parse_service(target)
        if "why" in s: m["why"] = s["why"]; return m
        m.update(kind=s["kind"], app=s.get("app", ""), command=s.get("command", ""),
                 adv={**s["adv"], "delay": sched[2]})
    m["full"] = True
    return m

def user_timers():
    try: files = sorted(os.listdir(UNITS))
    except OSError: return []
    return [n for n in files if n.endswith(".timer") and "@." not in n and os.path.isfile(f"{UNITS}/{n}")]

def timer_target(timer):
    u = read_unit(unit_path(timer)) or {}
    return (u.get("Timer", {}).get("Unit") or [timer[:-6] + ".service"])[0]

def unscheduled_services(timers):
    """Services in the user unit folder that no timer triggers."""
    used = {timer_target(t) for t in timers}
    try: files = sorted(os.listdir(UNITS))
    except OSError: return []
    return [n for n in files if n.endswith(".service") and "@." not in n and n not in used
            and os.path.isfile(f"{UNITS}/{n}")]

def list_services():
    """Names of the user's existing service units (not templates, not masked).
    Merges what systemd reports with the unit folders, so one source missing a unit doesn't hide it."""
    names = set()
    def add(n):
        if n.endswith(".service") and "@." not in n: names.add(n)
    for cmd in (("list-unit-files", "--type=service"), ("list-units", "--type=service", "--all")):
        for l in ctl(*cmd, "--no-legend", "--no-pager").stdout.splitlines():
            parts = l.replace("●", " ").replace("*", " ").split()
            if parts: add(parts[0])
    dirs = [UNITS, f"{APPS}/systemd/user", "/etc/systemd/user", "/usr/local/lib/systemd/user", "/usr/lib/systemd/user"]
    dirs += [f"{d}/systemd/user" for d in os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":") if d]
    for d in dirs:
        try: entries = os.listdir(d)
        except OSError: continue
        for n in entries:
            p = f"{d}/{n}"
            if os.path.isdir(p) and not os.path.islink(p): continue
            if os.path.realpath(p) == "/dev/null": continue      # masked
            add(n)
    return sorted(names)

def unique_base(name):
    """A unit name derived from the task name that clashes with no existing file or service."""
    stem = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "task"
    taken = set(list_services())
    base, i = stem, 2
    while (f"{base}.service" in taken or any(os.path.exists(f"{UNITS}/{base}{e}") for e in (".service", ".timer"))):
        base = f"{stem}-{i}"; i += 1
    return base


# ---------------------------------------------------------------- writing units
def unit_texts(t, old_service="", old_timer=""):
    """(service text or None, timer text). A task that triggers an existing service has no service of its own.
    The old file texts are merged, so lines the editor doesn't manage (ExecCondition=, comments, ...) survive.
    t["old_name"] == name leaves Description= alone; t["keep_exec"] leaves ExecStart= exactly as written.
    Raises ValueError if the command or app can't be turned into an ExecStart."""
    name, tr, adv = t["name"].replace("\n", " "), t["trigger"], t.get("adv", {})
    desc = t.get("old_name") != name
    never = lambda k, v: False
    service = None
    if t["kind"] != "service":
        keep_exec = bool(t.get("keep_exec") and old_service)
        unit = [f"Description={esc(name)}"] if desc else []
        if adv.get("ac"): unit.append("ConditionACPower=true")
        if adv.get("online"): unit += [f"Wants={ONLINE}", f"After={ONLINE}"]
        svc = [] if old_service else ["Type=oneshot"]
        if adv.get("cwd"): svc.append(f"WorkingDirectory={esc(adv['cwd'])}")
        for kv in shlex.split(adv.get("env", "")): svc.append(f"Environment={shlex.quote(esc(kv))}")   # no $ expansion here
        if adv.get("timeout"): svc.append(f"TimeoutStartSec={int(adv['timeout'])}min")
        if t["kind"] == "app": svc.append("KillMode=process")    # the launcher exits at once: don't kill the app it started
        if not keep_exec: svc.append(f"ExecStart={build_exec(t)}")
        def keep_unit(k, v):               # keep dependencies and conditions that aren't ours
            if k == "ConditionACPower": return v != "true"
            if k in ("Wants", "After"): return set(v.split()) != {ONLINE}
            return False
        service = merge_unit(old_service, {
            "Unit": ({"ConditionACPower", "Wants", "After"} | ({"Description"} if desc else set()), unit, keep_unit),
            "Service": ({"WorkingDirectory", "Environment", "TimeoutStartSec"} | (set() if keep_exec else {"ExecStart"})
                        | ({"KillMode"} if t["kind"] == "app" else set()),
                        svc, never)})
    timer = merge_unit(old_timer, {
        "Unit": ({"Description"} if desc else set(), [f"Description={esc(name)}"] if desc else [], never),
        "Timer": (set(SCHEDULE_KEYS) | {"Unit"},
                  ([f"Unit={t['service']}"] if t["kind"] == "service" else [])
                  + timer_lines(tr, t.get("catchup", True), adv.get("delay", 0)), never),
        "Install": ({"WantedBy"}, ["WantedBy=timers.target"], lambda k, v: v != "timers.target")})
    return service, timer

def apply_task(t):
    """Write the units for a task and (de)activate its timer. Returns an error text or None."""
    base = f"{UNITS}/{t['unit']}"
    service, timer = unit_texts(t, read_text(base + ".service"), read_text(base + ".timer"))
    try:
        os.makedirs(UNITS, exist_ok=True)
        for ext, text in ((".service", service), (".timer", timer)):
            if text is None:                   # the task was switched to an existing service: keep a backup
                if os.path.exists(base + ext):
                    try: os.replace(base + ext, base + ext + ".reveille-bak")
                    except OSError: pass
                continue
            write_atomic(base + ext, text)
    except OSError as e:
        return f"Could not write the unit files: {e.strerror or e}"
    ctl("daemon-reload")
    unit = f"{t['unit']}.timer"
    r = ctl("enable", "--now", unit) if t.get("enabled", True) else ctl("disable", "--now", unit)
    return r.stderr.strip() if r.returncode else None

def delete_plan(name):
    """The unit files that deleting `name` (a timer or a service without a timer) removes, as names in the
    user unit folder. A timer takes its same-named service along, unless another timer still triggers it."""
    names = [name]
    if name.endswith(".timer"):
        svc = name[:-6] + ".service"
        if timer_target(name) == svc and not any(timer_target(t) == svc for t in user_timers() if t != name):
            names.append(svc)
    def is_unit_file(n):
        p = f"{UNITS}/{n}"
        return os.path.islink(p) or os.path.isfile(p)
    return [n for n in names if is_unit_file(n)]

def remove_units(names):
    """Stop timers and delete the files (a symlink is removed as a link). Returns a snapshot for restore_units."""
    snap = {"items": [], "enable": [], "failed": []}
    for n in names:
        p = f"{UNITS}/{n}"
        if n.endswith(".timer"):
            if unit_status(n)[1]: snap["enable"].append(n)
            ctl("disable", "--now", n)
        try:
            if os.path.islink(p):
                snap["items"].append(("link", p, os.readlink(p)))
            else:
                with open(p, "rb") as f: snap["items"].append(("file", p, f.read()))
            os.unlink(p)
        except OSError:
            snap["items"] = [i for i in snap["items"] if i[1] != p]; snap["failed"].append(n)
    ctl("daemon-reload")
    return snap

def restore_units(snap):
    os.makedirs(UNITS, exist_ok=True)
    for kind, p, payload in snap["items"]:
        try:
            if os.path.lexists(p): continue            # something new took its place meanwhile: don't overwrite it
            if kind == "link": os.symlink(payload, p)
            else:
                with open(p, "wb") as f: f.write(payload)
        except OSError: pass
    ctl("daemon-reload")
    for n in snap["enable"]: ctl("enable", "--now", n)

def set_timer(name, on):
    """Turn a timer on (enable and start) or off (disable and stop). A hand-written timer without an [Install]
    section can't be enabled, so plain start/stop is the fallback. Returns an error text or None."""
    r = ctl("enable" if on else "disable", "--now", name)
    err = r.stderr.strip() if r.returncode else ""
    if r.returncode or unit_status(name)[1] != on:
        r2 = ctl("start" if on else "stop", name)
        if r2.returncode: return r2.stderr.strip() or err or "systemctl failed"
        if unit_status(name)[1] != on: return err or "The timer did not change state"
    return None

def start_now(m):
    ctl("start", "--no-block", m["service"])


def sh(*cmd, timeout=10):
    """Run a program; None if it is missing or too slow."""
    try: return subprocess.run(list(cmd), capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired): return None

def linger_state():
    """Whether systemd keeps this user's session (and so its timers) running while logged out:
    True, False, or None if it can't be told."""
    r = sh("loginctl", "show-user", str(os.getuid()), "-p", "Linger")
    m = re.search(r"^Linger=(\w+)", r.stdout, re.M) if r and r.returncode == 0 else None
    return m[1] == "yes" if m else None

def set_linger(on):
    """Turn lingering on or off for the current user. Returns an error text or None."""
    r = sh("loginctl", "enable-linger" if on else "disable-linger", timeout=30)
    if r is None: return "loginctl is not available"
    return (r.stderr.strip() or "loginctl failed") if r.returncode else None

LOG_HINT = ("No log entries for this service yet.\n\nIf it has run before, your system may not keep a per-user "
            "journal. Try: journalctl --user -u {unit}")

def read_log(service, lines=200):
    """The last lines of a service's journal: (text, None), or ("", error text)."""
    r = sh("journalctl", "--user", f"--unit={service}", "-n", str(int(lines)), "--no-pager", "-o", "short-iso",
           timeout=15)
    if r is None: return "", "journalctl is not available or took too long"
    if r.returncode: return "", r.stderr.strip() or "journalctl failed"
    text = r.stdout.strip()
    return (text, None) if text and not text.startswith("-- No entries") else (LOG_HINT.format(unit=service), None)

def task_texts(m):
    """(subtitle, tooltip) of a task row, from what gather() collected."""
    lines = [describe(m["trigger"]) if m["trigger"] else "Custom schedule"]
    if m["enabled"]:
        lines.append("Next: " + (m["next_text"] or "when triggered"))
        if m["fstate"] and m["fstate"] not in BOOT_OK: lines.append("Not enabled: won't start again after a restart")
    else:
        lines.append("Stopped, starts again at next login" if m["fstate"] in BOOT_OK else "Disabled")
    last, status = m["last"], []
    if m["running"]: status.append("Running now")
    if last: status.append(f"Last: {m['last_text']} " + ("OK" if last["rc"] == 0 else f"failed ({last['rc']})"))
    if status: lines.append(" · ".join(status))
    tip = [f"Next: {m['next']}" if m["enabled"] and m["next"] else "", f"Last: {last['time']}" if last else ""]
    return "\n".join(lines), "\n".join(x for x in tip if x)

def gather():
    """Everything the window lists, fetched with two systemctl calls however many tasks there are.
    No GTK in here, so it can run off the main thread."""
    timers = user_timers()
    st = show_many(timers, "ActiveState", "UnitFileState", "NextElapseUSecRealtime", "NextElapseUSecMonotonic")
    tasks = [m for m in (load_task(t, st) for t in timers) if m]
    sv = show_many(sorted({m["service"] for m in tasks}), "ActiveState", "Result", "ExecMainStatus",
                   "ExecMainExitTimestamp")
    now, mono = time.time(), time.monotonic()
    for m in tasks:
        kv, svc = st.get(m["timer"], {}), sv.get(m["service"], {})
        m["next"] = kv.get("NextElapseUSecRealtime", "").strip()
        ep = next_run_epoch(kv, now, mono)
        m["next_text"] = ("any moment" if ep <= now else relative(ep, now)) if ep else ""
        m["last"] = last_run_from(svc)
        lt = parse_ts(m["last"]["time"]) if m["last"] else None
        m["last_text"] = relative(lt, now) if lt else (m["last"] or {}).get("time", "")
        m["running"] = svc.get("ActiveState") in ("activating", "active")
    tasks.sort(key=lambda m: m["name"].lower())
    return {"tasks": tasks, "free": unscheduled_services(timers), "services": list_services(),
            "linger": linger_state()}


# ---------------------------------------------------------------- app menu
def menu_installed():
    return os.path.isfile(DESKTOP)

def refresh_desktop_db():
    try: subprocess.run(["update-desktop-database", os.path.dirname(DESKTOP)], capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired): pass

def install_menu():
    """Copy the program to a stable place and add an entry to the app menu. Returns an error text or None."""
    try:
        os.makedirs(os.path.dirname(INSTALLED), exist_ok=True)
        if os.path.realpath(SELF) != os.path.realpath(INSTALLED):
            shutil.copyfile(SELF, INSTALLED + ".tmp"); os.chmod(INSTALLED + ".tmp", 0o755)
            os.replace(INSTALLED + ".tmp", INSTALLED)
        os.makedirs(os.path.dirname(DESKTOP), exist_ok=True)
        cmd = f'"{sys.executable}" "{INSTALLED}"'
        with open(DESKTOP, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Task Scheduler\n"
                    "Comment=Run apps and commands on a schedule\n"
                    f"Exec={cmd}\nIcon=preferences-system-time\nTerminal=false\n"
                    "Categories=Utility;System;\nKeywords=schedule;timer;cron;task;\n")
    except OSError as e:
        return e.strerror or str(e)
    refresh_desktop_db()
    return None

def uninstall_menu():
    for p in (DESKTOP, INSTALLED):
        try: os.unlink(p)
        except OSError: pass
    refresh_desktop_db()


