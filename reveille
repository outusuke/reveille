            self.ac = Adw.SwitchRow(title="Only on AC power", active=adv.get("ac", False))
            self.online = Adw.SwitchRow(title="Wait for the network", active=adv.get("online", False))
            self.delay = Adw.SpinRow.new_with_range(0, 3600, 10)
            self.delay.set_title("Random delay (seconds)"); self.delay.set_subtitle("Spreads runs out so many tasks don't start at once")
            self.delay.set_value(adv.get("delay", 0))
            self.own_only = [self.cwd, self.env, self.timeout, self.ac, self.online]   # don't apply to an existing service
            for r in self.own_only + [self.delay]: g.add(r)

            if task:
                g = Adw.PreferencesGroup(); page.add(g)
                db = Gtk.Button(label="Delete task", halign=Gtk.Align.CENTER); db.add_css_class("destructive-action")
                db.connect("clicked", lambda *_: self.delete()); g.add(db)

            hb = Adw.HeaderBar(show_end_title_buttons=False, show_start_title_buttons=False)
            cancel = Gtk.Button(label="Cancel"); cancel.connect("clicked", lambda *_: self.close()); hb.pack_start(cancel)
            save = Gtk.Button(label="Save"); save.add_css_class("suggested-action")
            save.connect("clicked", lambda *_: self.save()); hb.pack_end(save)
            tv = Adw.ToolbarView(content=page); tv.add_top_bar(hb)
            self.set_child(tv)

            for w in (self.kind, self.trig, self.unit, self.svc):
                w.connect("notify::selected", self.refresh)
            for w in (self.hour, self.minute, self.dom, self.every):
                w.connect("notify::value", self.refresh)
            self.refresh()

        def trigger(self):
            tp = TRIGGER_IDS[self.trig.get_selected()]
            return {"type": tp, "expr": self.expr.get_text().strip(), "hour": int(self.hour.get_value()), "minute": int(self.minute.get_value()),
                    "days": [d for d, b in self.day_btns.items() if b.get_active()],
                    "dom": int(self.dom.get_value()), "every": int(self.every.get_value()),
                    "unit": "h" if self.unit.get_selected() == 1 else "min"}

        def refresh(self, *_):
            k = self.kind.get_selected()
            self.app.set_visible(k == 0); self.cmd.set_visible(k == 1); self.svc.set_visible(k == 2)
            for r in self.own_only: r.set_visible(k != 2)
            if self.ext:                                   # only the schedule of an existing timer is editable
                for r in (self.name, self.kind, self.app, self.cmd, self.svc, self.enabled, *self.own_only):
                    r.set_visible(False)
            tp = self.trig.get_selected()
            show = {self.hour: tp in (0, 1, 2), self.minute: tp in (0, 1, 2), self.days_row: tp == 1,
                    self.dom: tp == 2, self.every: tp == 3, self.unit: tp == 3, self.expr: tp == 5}
            for w, v in show.items(): w.set_visible(v)
            tr = self.trigger()
            self.preview.set_subtitle("Pick at least one day" if tp == 1 and not tr["days"] else next_elapse(tr))

        def save(self):
            name, tr = self.name.get_text().strip(), self.trigger()
            if tr["type"] == "custom" and (not calendar_parts(tr["expr"]) or any(
                    subprocess.run(["systemd-analyze", "calendar", p], capture_output=True).returncode
                    for p in calendar_parts(tr["expr"]))):
                return self.win.toast("That is not a valid calendar expression")
            if tr["type"] == "weekly" and not tr["days"]: return self.win.toast("Pick at least one day")
            if self.ext:
                err = rewrite_timer(self.ext, tr, self.catchup.get_active(), int(self.delay.get_value()))
                self.close(); self.win.fill()
                return self.win.toast(f"Could not save: {err}" if err else "Schedule updated")
            k = self.kind.get_selected()
            if not name: return self.win.toast("Give the task a name")
            if tr["type"] == "weekly" and not tr["days"]: return self.win.toast("Pick at least one day")
            t = dict(self.task or {"id": uuid.uuid4().hex[:8]})
            t.update(name=name, kind=["app", "command", "service"][k], trigger=tr,
                     catchup=self.catchup.get_active(), enabled=self.enabled.get_active())
            try:
                shlex.split(self.env.get_text())
            except ValueError:
                return self.win.toast("The environment field has an unclosed quote")
            t["adv"] = {"cwd": self.cwd.get_text().strip(), "env": self.env.get_text().strip(),
                        "timeout": int(self.timeout.get_value()), "ac": self.ac.get_active(),
                        "online": self.online.get_active(), "delay": int(self.delay.get_value())}
            if k == 0:
                if not self.apps: return self.win.toast("No applications found")
                t["app"] = self.apps[self.app.get_selected()].get_id()
            elif k == 2:
                if not self.services: return self.win.toast("No user services found")
                t["service"] = self.services[self.svc.get_selected()]
            else:
                t["command"] = self.cmd.get_text().strip()
                try:
                    if not shlex.split(t["command"]): raise ValueError
                except ValueError:
                    return self.win.toast("Enter a valid command")
            tasks = load_tasks()
            tasks = [x for x in tasks if x["id"] != t["id"]] + [t]
            save_tasks(tasks)
            err = apply_task(t)
            self.close(); self.win.fill()
            self.win.toast(f"Saved, but systemd said: {err[:80]}" if err else "Task saved")

        def delete(self):
            tid, snapshot = self.task["id"], self.task
            remove_task_units(tid)
            save_tasks([x for x in load_tasks() if x["id"] != tid])
            self.close(); self.win.fill()
            self.win.toast("Task deleted", "Undo", lambda: self.win.restore(snapshot))

    class Win(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Task Scheduler", default_width=640, default_height=560)
            self.overlay = Adw.ToastOverlay()
            tv = Adw.ToolbarView(); hb = Adw.HeaderBar()
            add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="New task")
            add.connect("clicked", lambda *_: self.edit(None)); hb.pack_start(add)
            self.menu_btn = Gtk.MenuButton(icon_name="open-menu-symbolic", tooltip_text="Main menu")
            hb.pack_end(self.menu_btn)
            for name, fn in (("install-menu", self.do_install), ("remove-menu", self.do_remove)):
                a = Gio.SimpleAction.new(name, None); a.connect("activate", lambda *_a, fn=fn: fn()); self.add_action(a)
            self.update_menu()
            tv.add_top_bar(hb)
            self.stack = Gtk.Stack()
            empty = Adw.StatusPage(icon_name="alarm-symbolic", title="No tasks yet",
                                   description="Schedule an app or a command to run automatically.")
            first = Gtk.Button(label="Create task", halign=Gtk.Align.CENTER)
            first.add_css_class("suggested-action"); first.add_css_class("pill")
            first.connect("clicked", lambda *_: self.edit(None)); empty.set_child(first)
            self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE); self.list.add_css_class("boxed-list")
            self.ext_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE); self.ext_list.add_css_class("boxed-list")
            self.h1 = Gtk.Label(label="Your tasks", xalign=0); self.h1.add_css_class("heading")
            self.h2 = Gtk.Label(label="Other services in ~/.config/systemd/user", xalign=0); self.h2.add_css_class("heading")
            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            for w in (self.h1, self.list, self.h2, self.ext_list): body.append(w)
            clamp = Adw.Clamp(maximum_size=640, margin_top=12, margin_bottom=12, margin_start=12, margin_end=12,
                              child=body)
            self.stack.add_named(empty, "empty"); self.stack.add_named(Gtk.ScrolledWindow(child=clamp), "list")
            tv.set_content(self.stack); self.overlay.set_child(tv); self.set_content(self.overlay)
            self.fill()
            GLib.timeout_add_seconds(30, lambda: (self.fill(), True)[1])

        def update_menu(self):
            m = Gio.Menu()
            if menu_installed(): m.append("Remove from app menu", "win.remove-menu")
            else: m.append("Add to app menu", "win.install-menu")
            self.menu_btn.set_menu_model(m)

        def do_install(self):
            err = install_menu()
            self.update_menu(); self.fill()
            self.toast(f"Could not add it: {err}" if err else "Added to the app menu")

        def do_remove(self):
            uninstall_menu(); self.update_menu(); self.fill()
            self.toast("Removed from the app menu")

        def toast(self, msg, button=None, cb=None):
            t = Adw.Toast(title=msg, timeout=5)
            if button:
                t.set_button_label(button); t.connect("button-clicked", lambda *_: cb())
            self.overlay.add_toast(t)

        def edit(self, task, preset=None, ext=None):
            Editor(self, task, preset, ext).present(self)

        def edit_external(self, unit):
            if parse_timer(unit) is None:
                self.toast("This timer uses options the editor can't show, opening its file")
                Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(timer_path(unit)), None)
            else:
                self.edit(None, None, unit)

        def restore(self, task):
            save_tasks(load_tasks() + [task]); apply_task(task); self.fill()

        def toggle(self, task, on):
            task["enabled"] = on
            save_tasks([task if x["id"] == task["id"] else x for x in load_tasks()])
            apply_task(task); self.fill()

        def fill(self):
            while (r := self.list.get_first_child()) is not None: self.list.remove(r)
            tasks = sorted(load_tasks(), key=lambda t: t["name"].lower())
            ext = external_units()
            while (r := self.ext_list.get_first_child()) is not None: self.ext_list.remove(r)
            self.stack.set_visible_child_name("list" if tasks or ext else "empty")
            self.h1.set_visible(bool(tasks) and bool(ext)); self.list.set_visible(bool(tasks))
            self.h2.set_visible(bool(ext)); self.ext_list.set_visible(bool(ext))
            self.fill_external(ext)
            for t in tasks:
                nxt, active = timer_status(t["id"]); last = last_run(t)
                parts = [describe(t["trigger"])]
                if t.get("enabled", True) and active:
                    parts.append(f"Next: {nxt}" if nxt else "Next: when triggered")
                elif not t.get("enabled", True): parts.append("Disabled")
                if last: parts.append(f"Last: {last['time']} " + ("OK" if last["rc"] == 0 else f"failed ({last['rc']})"))
                row = Adw.ActionRow(title=GLib.markup_escape_text(t["name"]),
                                    subtitle=GLib.markup_escape_text("\n".join(parts)), activatable=True)
                bad = last and last["rc"] != 0
                img = Gtk.Image(icon_name="dialog-warning-symbolic" if bad else "alarm-symbolic")
                if bad: img.add_css_class("error")
                row.add_prefix(img)
                row.add_suffix(icon_btn("media-playback-start-symbolic", "Run now",
                                        lambda t=t: (start_now(t), self.toast("Started"))))
                sw = Gtk.Switch(active=t.get("enabled", True), valign=Gtk.Align.CENTER)
                sw.connect("state-set", lambda _s, on, t=t: (self.toggle(t, on), False)[1])
                row.add_suffix(sw)
                row.connect("activated", lambda _r, t=t: self.edit(t))
                self.list.append(row)

    def _ext_row(win, svc, timers):
        row = Adw.ActionRow(title=GLib.markup_escape_text(svc))
        if timers:
            nxt, active = unit_status(timers[0])
            row.set_subtitle(GLib.markup_escape_text(
                (f"Next: {nxt}" if nxt else "Timer active") if active else "Timer off")
                + (f" · {len(timers)} timers" if len(timers) > 1 else ""))
            sw = Gtk.Switch(active=active, valign=Gtk.Align.CENTER)
            sw.connect("state-set", lambda _s, on: (set_timers(timers, on), GLib.idle_add(win.fill), False)[2])
            row.add_prefix(Gtk.Image(icon_name="alarm-symbolic"))
        else:
            row.set_subtitle("No schedule")
            row.add_prefix(Gtk.Image(icon_name="emblem-system-symbolic"))
        row.add_suffix(icon_btn("media-playback-start-symbolic", "Run now",
                                lambda: (ctl("start", "--no-block", svc), win.toast("Started"))))
        if timers:
            row.add_suffix(icon_btn("document-edit-symbolic", "Edit schedule" + (f" of {timers[0]}" if len(timers) > 1 else ""),
                                    lambda: win.edit_external(timers[0])))
            row.add_suffix(sw)
        else:
            b = Gtk.Button(label="Schedule…", valign=Gtk.Align.CENTER)
            b.connect("clicked", lambda *_: win.edit(None, svc)); row.add_suffix(b)
        return row

    Win.fill_external = lambda self, ext: [self.ext_list.append(_ext_row(self, s_, t_)) for s_, t_ in ext]

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id="io.github.reveille")
        def do_activate(self):
            (self.props.active_window or Win(self)).present()

    return App().run([])


