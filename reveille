# ---------------------------------------------------------------- unit files
def esc(s):                       # "%" is special in unit files
    return s.replace("%", "%%")

def unesc(s):
    return s.replace("%%", "%")

def xesc(s):                      # in ExecStart "$" is special too
    return esc(s).replace("$", "$$")

def xunesc(s):
    return unesc(s.replace("$$", "$"))

def unit_path(unit):
    return os.path.realpath(f"{UNITS}/{unit}")

def read_text(path):
    try:
        with open(path) as f: return f.read()
    except OSError:
        return ""

def groups(text):
    """Split a unit file into logical lines: a line ending in a backslash continues on the next one."""
    out, cur = [], []
    for l in text.splitlines():
        cur.append(l)
        if not l.rstrip().endswith("\\"):
            out.append(cur); cur = []
    if cur: out.append(cur)
    return out

def joined(g):
    return " ".join((x.rstrip()[:-1] if i < len(g) - 1 else x).strip() for i, x in enumerate(g))

def read_unit(path):
    """{section: {key: [values]}} or None if the file can't be read."""
    try:
        with open(path) as f: text = f.read()
    except OSError:
        return None
    out, sect = {}, None
    for g in groups(text):
        st = joined(g).strip()
        if not st or st[0] in "#;": continue
        if st.startswith("["): sect = st.strip("[]"); out.setdefault(sect, {}); continue
        if sect is not None and "=" in st:
            k, v = st.split("=", 1); out[sect].setdefault(k.strip(), []).append(v.strip())
    return out

def merge_unit(text, spec):
    """Rewrite only the lines the editor manages and keep every other line, comment and section as it was.
    spec = {section: (managed keys, new lines, keep)}: lines of a managed key are dropped unless keep(key, value)
    says to keep that one, and the new lines go where the first dropped line was (or at the end of the section)."""
    out, sect, slot, end, seen = [], None, {}, {}, set()
    def close():
        if sect is not None:
            j = len(out)
            while j > 0 and not out[j - 1].strip(): j -= 1
            end[sect] = j
    for g in groups(text):
        st = joined(g).strip()
        if st.startswith("[") and "]" in st:
            close(); sect = st[1:st.index("]")]; seen.add(sect); out += g; continue
        if sect in spec and "=" in st and st[0] not in "#;":
            k, v = (x.strip() for x in st.split("=", 1))
            managed, _, keep = spec[sect]
            if k in managed and not keep(k, v):
                slot.setdefault(sect, len(out)); continue
        out += g
    close()
    ins = [(slot.get(s, end.get(s)), new) for s, (_, new, _) in spec.items() if new and s in seen]
    for i, lines in sorted(ins, key=lambda x: -x[0]): out[i:i] = lines
    for s, (_, new, _) in spec.items():
        if new and s not in seen: out += ([""] if out else []) + [f"[{s}]"] + new
    return "\n".join(out) + "\n"

def write_atomic(path, text):
    """Write a file so a crash or full disk never leaves a half-written unit. A symlink is followed: the file
    it points to is replaced, the link stays."""
    path = os.path.realpath(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".reveille-")
    try:
        with os.fdopen(fd, "w") as f: f.write(text)
        try: os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        except OSError: os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try: os.unlink(tmp)
        except OSError: pass
        raise

SPAN_UNITS = {"us": 1e-6, "usec": 1e-6, "ms": 1e-3, "msec": 1e-3, "": 1, "s": 1, "sec": 1, "second": 1, "seconds": 1,
              "m": 60, "min": 60, "minute": 60, "minutes": 60, "h": 3600, "hr": 3600, "hour": 3600, "hours": 3600,
              "d": 86400, "day": 86400, "days": 86400, "w": 604800, "week": 604800, "weeks": 604800}

def parse_span(text):
    """A systemd time span (\"90\", \"5min\", \"1h 30min\") as whole seconds, or None if it isn't one."""
    text = text.strip()
    if not re.fullmatch(r"(?:\d+\s*[a-z]*\s*)+", text): return None
    total = 0
    for n, u in re.findall(r"(\d+)\s*([a-z]*)", text):
        if u not in SPAN_UNITS: return None
        total += int(n) * SPAN_UNITS[u]
    return int(total)

def parse_span_f(text):
    """Like parse_span, for the fractional spans systemctl prints ("1h 2min 3.5s"): seconds as a float, or None."""
    text = text.strip()
    if not re.fullmatch(r"(?:\d+(?:\.\d+)?\s*[a-z]*\s*)+", text): return None
    total = 0.0
    for n, u in re.findall(r"(\d+(?:\.\d+)?)\s*([a-z]*)", text):
        if u not in SPAN_UNITS: return None
        total += float(n) * SPAN_UNITS[u]
    return total

def exact_span(text):
    """A time span as whole seconds, or None if it isn't one or has a fraction of a second (parse_span would
    quietly round that down, and a saved schedule must mean what was written)."""
    f = parse_span_f(text)
    return int(f) if f is not None and f == int(f) else None

def fmt_span(secs):
    """Whole seconds as the shortest exact systemd span: 7200 -> "2h", 5400 -> "90min", 45 -> "45s"."""
    if secs == 0: return "0"
    for suffix, size in (("d", 86400), ("h", 3600), ("min", 60)):
        if secs % size == 0: return f"{secs // size}{suffix}"
    return f"{secs}s"

def split_interval(secs):
    """(n, unit) with the largest unit that divides `secs` evenly, or None if that doesn't fit the editor."""
    for unit in ("d", "h", "min", "s"):
        if secs % INTERVAL_UNITS[unit] == 0:
            n = secs // INTERVAL_UNITS[unit]
            return (n, unit) if 1 <= n <= MAX_EVERY else None
    return None

def interval_seconds(tr):
    return int(tr.get("every", 1)) * INTERVAL_UNITS.get(tr.get("unit"), 60)

def human_span(secs):
    """"90 s", "5 min", "2 h", "3 days" """
    n, unit = split_interval(secs) or (secs, "s")
    return f"{n} " + ({"s": "s", "min": "min", "h": "h"}.get(unit) or ("day" if n == 1 else "days"))

def ordinal(n):
    return f"{n}" + ("th" if 10 <= n % 100 <= 20 else {1: "st", 2: "nd", 3: "rd"}.get(n % 10, "th"))

def parse_times(text):
    """"8:00, 12:30 18:00" -> ["08:00", "12:30", "18:00"] (sorted, no repeats), or None if it is empty or
    anything in it isn't a clock time."""
    out = set()
    for p in (x for x in re.split(r"[,;|\s]+", text.strip()) if x):
        m = re.fullmatch(r"(\d{1,2}):(\d\d)", p)
        if not m or int(m[1]) > 23 or int(m[2]) > 59: return None
        out.add(f"{int(m[1]):02d}:{m[2]}")
    return sorted(out) or None

def parse_ts(text):
    """A timestamp as systemctl prints it ("Tue 2026-11-10 03:00:00 -03", local time) as epoch seconds, or None."""
    m = re.search(r"(\d{4})-(\d\d)-(\d\d) (\d\d):(\d\d):(\d\d)", text or "")
    return time.mktime((*map(int, m.groups()), 0, 0, -1)) if m else None

def next_run_epoch(kv, now=None, mono=None):
    """When a timer fires next, from its properties. Calendar timers carry a wall-clock time; interval and login
    timers only a monotonic one, which is turned into wall-clock time with the same clock Python uses."""
    t = parse_ts(kv.get("NextElapseUSecRealtime", ""))
    if t: return t
    span = parse_span_f(kv.get("NextElapseUSecMonotonic", ""))
    if not span: return None                    # 0, "infinity" or unreadable: nothing is scheduled
    now = time.time() if now is None else now
    mono = time.monotonic() if mono is None else mono
    return now + (span - mono)

def relative(epoch, now=None):
    """A moment as people say it: "in 12 min", "tomorrow 03:00", "yesterday 03:00", "3 days ago"."""
    now = time.time() if now is None else now
    d = epoch - now; a = abs(d); fut = d > 0
    if a < 60: return "in less than a minute" if fut else "just now"
    if a < 3600: n = round(a / 60); return f"in {n} min" if fut else f"{n} min ago"
    days = (datetime.date.fromtimestamp(epoch) - datetime.date.fromtimestamp(now)).days
    clock = time.strftime("%H:%M", time.localtime(epoch))
    if days == 0 and a < 6 * 3600:
        h, m = divmod(round(a / 60), 60); span = f"{h} h" + (f" {m} min" if m else "")
        return f"in {span}" if fut else f"{span} ago"
    if days == 0: return f"today {clock}"
    if days == 1: return f"tomorrow {clock}"
    if days == -1: return f"yesterday {clock}"
    if -7 < days < 0: return f"{-days} days ago"
    return time.strftime("%a %d %b %H:%M", time.localtime(epoch))

def ctl(*a):
    return subprocess.run(["systemctl", "--user", *a], capture_output=True, text=True)

def props(unit, *names):
    r = ctl("show", unit, *[x for n in names for x in ("-p", n)])
    return dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)

def show_many(units, *names):
    """One `systemctl show` for many units instead of one process each: {unit: {property: value}}."""
    if not units: return {}
    r = ctl("show", *units, *[x for n in ("Id",) + names for x in ("-p", n)])
    out = {}
    for block in r.stdout.split("\n\n"):
        kv = dict(l.split("=", 1) for l in block.splitlines() if "=" in l)
        if "Id" in kv: out[kv["Id"]] = kv
    return out

def unit_status(unit):
    """(next run text or "", is_active) for a timer unit"""
    kv = props(unit, "ActiveState", "NextElapseUSecRealtime")
    return kv.get("NextElapseUSecRealtime", "").strip(), kv.get("ActiveState") == "active"

def last_run_from(kv):
    if not kv.get("ExecMainExitTimestamp"): return None
    rc = 0 if kv.get("Result") == "success" else (int(kv.get("ExecMainStatus") or 0) or 1)
    return {"time": kv["ExecMainExitTimestamp"], "rc": rc}

def last_run(service):
    """Last result of a service, straight from systemd: {"time", "rc"} or None."""
    return last_run_from(props(service, "Result", "ExecMainStatus", "ExecMainExitTimestamp"))


# ---------------------------------------------------------------- schedules
def on_calendar(tr):
    h, m = int(tr.get("hour", 0)), int(tr.get("minute", 0))
    t = tr["type"]
    if t == "daily":
        return f"*-*-* {h:02d}:{m:02d}:00"
    if t == "weekdays":
        return f"{','.join(WEEKDAYS)} *-*-* {h:02d}:{m:02d}:00"
    if t == "weekly":
        days = ",".join(d for d in DAYS if d in tr.get("days", []))
        return f"{days} *-*-* {h:02d}:{m:02d}:00"
    if t == "monthly":
        return f"*-*-{int(tr.get('dom', 1)):02d} {h:02d}:{m:02d}:00"
    if t == "lastday":
        return f"*-*~01 {h:02d}:{m:02d}:00"
    if t == "times":                                    # one OnCalendar= line each, so the minutes can differ
        return " | ".join(f"*-*-* {x}:00" for x in tr.get("times") or []) or None
    if t == "custom":
        return tr.get("expr", "").strip() or None
    return None

def describe(tr):
    t, hm = tr["type"], f"{int(tr.get('hour', 0)):02d}:{int(tr.get('minute', 0)):02d}"
    if t == "daily": return f"Every day at {hm}"
    if t == "weekdays": return f"Weekdays at {hm}"
    if t == "weekly":
        days = [d for d in DAYS if d in tr.get("days", [])]
        who = ("Every day" if len(days) == 7 else "Weekdays" if days == WEEKDAYS else
               "Weekends" if days == DAYS[5:] else ", ".join(days))
        return f"{who} at {hm}"
    if t == "monthly": return f"On the {ordinal(int(tr.get('dom', 1)))} of every month at {hm}"
    if t == "lastday": return f"Last day of every month at {hm}"
    if t == "times": return "Every day at " + ", ".join(tr.get("times") or [hm])
    if t == "custom": return tr.get("expr", "custom schedule")
    if t == "interval":
        one, many = EVERY_NAMES.get(tr.get("unit"), EVERY_NAMES["min"]); n = int(tr.get("every", 1))
        text = f"Every {one}" if n == 1 else f"Every {n} {many}"
        first = tr.get("first_sec")
        return text if first is None or first == interval_seconds(tr) else f"{text}, first run {human_span(first)} after login"
    sec = int(tr.get("login_sec", 10))
    return "At login" if sec in (0, 10) else f"At login, after {human_span(sec)}"

def calendar_parts(expr):
    """A custom schedule may hold several calendar expressions separated by | (one OnCalendar= line each)."""
    return [p.strip() for p in expr.split("|") if p.strip()]

def next_elapse(tr):
    """Text for the live preview in the editor."""
    cal = on_calendar(tr)
    if cal:
        res = []
        for part in calendar_parts(cal):
            try:
                out = subprocess.run(["systemd-analyze", "calendar", part], capture_output=True, text=True, timeout=5).stdout
            except (OSError, subprocess.TimeoutExpired):
                return "Preview unavailable"
            nxt = re.search(r"Next elapse:\s*(.+)", out)
            left = re.search(r"From now:\s*(.+)", out)
            if not nxt: return "Not a valid schedule"
            res.append(nxt.group(1).strip() + (f"  ({left.group(1).strip()})" if left else ""))
        return "\n".join(res) if res else "Not a valid schedule"
    if tr["type"] == "interval":
        first = tr.get("first_sec")
        every = interval_seconds(tr)
        return f"First run {human_span(every if first is None else first)} after login, then every {human_span(every)}"
    sec = int(tr.get("login_sec", 10))
    return "Shortly after you log in" if sec <= 60 else f"{human_span(sec)} after you log in"

def needs_precision(secs):
    """systemd lets a timer fire up to a minute late (AccuracySec=1min) so wake-ups can be shared. An interval
    that isn't a whole number of minutes would be off by a large share of its length."""
    return secs < 60 or secs % 60 != 0

def timer_lines(tr, catchup, delay):
    """The schedule lines of a timer. Raises ValueError if the schedule is empty, so nothing is half-written."""
    out, cal = [], on_calendar(tr)
    if tr["type"] in CALENDAR_TYPES:
        if not cal: raise ValueError("The schedule is empty")
        out += [f"OnCalendar={p}" for p in calendar_parts(cal)]
        if catchup: out.append("Persistent=true")
    elif tr["type"] == "interval":
        secs = interval_seconds(tr)
        if secs < 1: raise ValueError("The interval must be at least one second")
        first = tr.get("first_sec")
        if first is not None and first < 0: raise ValueError("The first run can't be negative")
        key = tr.get("first_key") or "OnStartupSec"      # keep the key a hand-written timer used (OnBootSec= counts from boot)
        out += [f"{key}={fmt_span(secs if first is None else first)}", f"OnUnitActiveSec={fmt_span(secs)}"]
        if needs_precision(secs): out.append("AccuracySec=1s")
    else:
        out.append(f"OnStartupSec={fmt_span(int(tr.get('login_sec', 10)))}")
    if delay: out.append(f"RandomizedDelaySec={int(delay)}")
    return out

def timer_keep(tr):
    """keep(key, value) for the [Timer] section: AccuracySec= is the user's own, except for an interval that
    needs the precise one, where the editor writes it itself."""
    precise = tr["type"] == "interval" and needs_precision(interval_seconds(tr))
    return lambda k, v: k == "AccuracySec" and not precise

DAY_RE = "|".join(DAYS)

def parse_days(spec):
    """"Mon,Wed" or "Mon..Fri,Sun" as a list of days in week order, or None if it isn't that."""
    days = set()
    for part in spec.split(","):
        m = re.fullmatch(rf"({DAY_RE})(?:\.\.({DAY_RE}))?", part)
        if not m: return None
        a = DAYS.index(m[1]); b = DAYS.index(m[2]) if m[2] else a
        if b < a: return None
        days.update(DAYS[a:b + 1])
    return [d for d in DAYS if d in days]

def times_of(tr):
    """The clock times of a daily or several-times trigger as ["HH:MM", ...], else None."""
    if tr["type"] == "daily": return [f"{tr['hour']:02d}:{tr['minute']:02d}"]
    if tr["type"] == "times": return tr["times"]
    return None

def from_calendar(expr):
    e = expr.strip()
    if e == "daily": return {"type": "daily", "hour": 0, "minute": 0}
    date, clock = r"(?:\*-\*-\* )?", r"(\d\d?(?:,\d\d?)*):(\d\d)(?::00)?"
    def at(hours, minute):                              # "8,12", "30" -> ([8, 12], 30), or None if out of range
        hs = sorted({int(x) for x in hours.split(",")})
        return (hs, int(minute)) if hs[-1] < 24 and int(minute) < 60 else None
    m = re.fullmatch(rf"{date}{clock}", e)
    t = at(m[1], m[2]) if m else None
    if t:
        (hs, mi) = t
        if len(hs) == 1: return {"type": "daily", "hour": hs[0], "minute": mi}
        return {"type": "times", "times": [f"{h:02d}:{mi:02d}" for h in hs]}
    m = re.fullmatch(rf"([A-Za-z.,]+) {date}{clock}", e)
    days, t = (parse_days(m[1]), at(m[2], m[3])) if m else (None, None)
    if days and t and len(t[0]) == 1:
        return {"type": "weekdays" if days == WEEKDAYS else "weekly", "days": days, "hour": t[0][0], "minute": t[1]}
    m = re.fullmatch(rf"\*-\*-(\d\d?) {clock}", e)
    t = at(m[2], m[3]) if m else None
    if t and len(t[0]) == 1 and 1 <= int(m[1]) <= 28:
        return {"type": "monthly", "dom": int(m[1]), "hour": t[0][0], "minute": t[1]}
    m = re.fullmatch(rf"\*-\*~0?1 {clock}", e)
    t = at(m[1], m[2]) if m else None
    if t and len(t[0]) == 1: return {"type": "lastday", "hour": t[0][0], "minute": t[1]}
    return {"type": "custom", "expr": e}

def parse_schedule(kv):
    """Read the [Timer] keys as (trigger, catchup, delay), or None if they use something the editor would lose."""
    if any(k in kv for k in ("OnActiveSec", "OnUnitInactiveSec")): return None
    catchup = kv.get("Persistent", ["false"])[-1].lower() in ("true", "yes", "1", "on")
    delay = 0
    if "RandomizedDelaySec" in kv:
        delay = parse_span(kv["RandomizedDelaySec"][-1])
        if delay is None: return None
    cals, start = kv.get("OnCalendar", []), kv.get("OnStartupSec", []) + kv.get("OnBootSec", [])
    active = kv.get("OnUnitActiveSec", [])
    if len(cals) == 1 and not start and not active:
        tr = from_calendar(cals[0])
    elif len(cals) > 1 and not start and not active:
        parts = [from_calendar(c) for c in cals]
        lists = [times_of(p) for p in parts]
        if all(lists):                                  # several clock times: one OnCalendar= line each
            ts = sorted({x for l in lists for x in l})
            tr = ({"type": "times", "times": ts} if len(ts) > 1 else
                  {"type": "daily", "hour": int(ts[0][:2]), "minute": int(ts[0][3:])})
        else:
            tr = {"type": "custom", "expr": " | ".join(cals)}
    elif not cals and len(active) == 1 and len(start) <= 1:
        total = exact_span(active[0])
        if not total: return None
        step = split_interval(total)
        if not step: return None
        tr = {"type": "interval", "every": step[0], "unit": step[1]}
        if start:                                       # a first run that differs from the interval is shown, not refused
            first = exact_span(start[0])
            if first is None: return None
            if first != total: tr["first_sec"] = first
            if "OnBootSec" in kv: tr["first_key"] = "OnBootSec"
    elif not cals and not active and len(start) == 1:
        sec = exact_span(start[0])
        if sec is None: return None
        tr = {"type": "login", "login_sec": sec}
    else:
        return None
    return {**DEFAULT_TR, **tr}, catchup, delay

def rewrite_timer(unit, tr, catchup, delay):
    """Replace only the schedule lines of a hand-written timer; everything else in the file is kept."""
    path = unit_path(unit)
    lines = timer_lines(tr, catchup, delay)             # before anything is written: it can refuse
    try:
        with open(path) as f: text = f.read()
        if not os.path.exists(path + ".reveille-bak"):          # one-time backup of the original
            write_atomic(path + ".reveille-bak", text)
        write_atomic(path, merge_unit(text, {"Timer": (TIMER_KEYS, lines, timer_keep(tr))}))
    except OSError as e:
        return e.strerror or str(e)
    ctl("daemon-reload")
    if unit_status(unit)[1]: ctl("restart", unit)
    return None


# ---------------------------------------------------------------- tasks, read from the units themselves
def build_exec(t):
    """The ExecStart= value for an app or command task. Raises ValueError with a readable reason."""
    if t["kind"] == "app":
        from gi.repository import Gio
        info = Gio.DesktopAppInfo.new(t["app"])
        path = info.get_filename() if info else None
        if not path: raise ValueError(f"{t['app']} is not installed")
        gio, gtk = shutil.which("gio"), shutil.which("gtk-launch")
        if gio: tokens = [gio, "launch", path]
        elif gtk: tokens = [gtk, t["app"]]
        else: raise ValueError("Neither gio nor gtk-launch was found")
    else:
        tokens = shlex.split(t["command"])
        if not tokens: raise ValueError("Enter a valid command")
        if not os.path.isabs(tokens[0]):
            found = shutil.which(tokens[0])
            if not found: raise ValueError(f"{tokens[0]} was not found in PATH")
            tokens[0] = found
    return " ".join(xesc(shlex.quote(x)) for x in tokens)

def parse_service(name):
    """Read the settings the editor manages from a service file. Every other line is left alone when saving.
    Returns {"why": reason} if a managed setting is in a form the editor can't represent."""
    u = read_unit(unit_path(name))
    if u is None: return {"why": "the service file can't be read"}
    un, sv = u.get("Unit", {}), u.get("Service", {})
    if len(sv.get("ExecStart", [])) != 1: return {"why": "the service doesn't have exactly one ExecStart= line"}
    cmd = xunesc(sv["ExecStart"][0])
    if not cmd or cmd[0] in "-@:+!|": return {"why": "ExecStart= starts with a special prefix (- @ + ! :)"}
    try: tokens = shlex.split(cmd)
    except ValueError: return {"why": "ExecStart= can't be split into words"}
    deps = [x for v in un.get("Wants", []) + un.get("After", []) for x in v.split()]
    timeout = 0
    if "TimeoutStartSec" in sv:
        m = re.fullmatch(r"(\d+)min", sv["TimeoutStartSec"][-1])
        if not m: return {"why": "TimeoutStartSec= isn't a whole number of minutes"}
        timeout = int(m[1])
    env = []
    for v in sv.get("Environment", []):
        try: env += [unesc(x) for x in shlex.split(v)]
        except ValueError: return {"why": "Environment= has an unclosed quote"}
    retries, wait = 0, 5
    mode = sv.get("Restart", ["no"])[-1]
    if mode not in ("no", "on-failure"): return {"why": "Restart= is something other than on-failure"}
    if mode == "on-failure":
        burst = (un.get("StartLimitBurst") or [""])[-1]
        if not re.fullmatch(r"\d+", burst) or not 2 <= int(burst) <= 11:
            return {"why": "Restart=on-failure has no StartLimitBurst= between 2 and 11"}
        retries = int(burst) - 1
        m = re.fullmatch(r"([1-9]\d*)min", (sv.get("RestartSec") or [""])[-1])
        if not m or int(m[1]) > 1440: return {"why": "RestartSec= isn't a whole number of minutes (1 to 1440)"}
        wait = int(m[1])
    paths = un.get("ConditionPathExists", [])
    if len(paths) > 1: return {"why": "there are several ConditionPathExists= lines"}
    then = [x for v in un.get("OnSuccess", []) for x in v.split()]
    if len(then) > 1: return {"why": "OnSuccess= lists more than one unit"}
    fail = [x for v in un.get("OnFailure", []) for x in v.split()]
    if len(fail) > 1: return {"why": "OnFailure= lists more than one unit"}
    adv = {"cwd": unesc(sv.get("WorkingDirectory", [""])[-1]), "env": " ".join(shlex.quote(x) for x in env),
           "timeout": timeout, "ac": "true" in un.get("ConditionACPower", []), "online": ONLINE in deps,
           "retries": retries, "retry_wait": wait,
           "low": sv.get("Nice") == ["19"] and sv.get("IOSchedulingClass") == ["idle"],
           "path": unesc(paths[0]) if paths else "", "then": then[0] if then else "",
           "fail": fail[0] if fail else ""}
    s = {"adv": adv, "kind": "command", "command": cmd}
    if len(tokens) == 3 and os.path.basename(tokens[0]) == "gio" and tokens[1] == "launch":
        s.update(kind="app", app=os.path.basename(tokens[2]))
    elif len(tokens) == 2 and os.path.basename(tokens[0]) == "gtk-launch":
        s.update(kind="app", app=tokens[1] if tokens[1].endswith(".desktop") else tokens[1] + ".desktop")
    return s

def retry_window(retries, wait_min, timeout_min=0):
    """Seconds of systemd's start-limit window for a task that retries `retries` times. It has to be long enough
    to hold every try, or the count is never reached and a failing task would retry forever. How long a run takes
    is only known when there is a timeout, so one hour is assumed otherwise."""
    return (retries + 1) * (wait_min + (timeout_min or 60)) * 60 + 60

def then_cycle(service, then):
    """True if starting `then` after `service` succeeds (OnSuccess=) or fails (OnFailure=) would lead back to
    `service` through such links. Either kind of link can close the loop, so both are followed."""
    seen, todo = set(), [then]
    while todo:
        cur = todo.pop()
        if cur == service: return True
        if cur in seen or not cur: continue
        seen.add(cur)
        u = read_unit(unit_path(cur)) or {}
        todo += [x for k in ("OnSuccess", "OnFailure") for v in u.get("Unit", {}).get(k, []) for x in v.split()]
    return False

def dropin_info(unit, watched):
    """The drop-in files of `unit` ("NAME.service.d/x.conf", from the user unit folder) and, if one of them sets a key
    in `watched` ({section: keys}), a reason saying which; "" if none does. Such a key is one the editor shows,
    so what it shows would no longer be what systemd runs."""
    folder = f"{UNITS}/{unit}.d"
    try: names = sorted(n for n in os.listdir(folder) if n.endswith(".conf") and os.path.isfile(f"{folder}/{n}"))
    except OSError: return [], ""
    why = []
    for n in names:
        u = read_unit(f"{folder}/{n}") or {}
        hit = []
        for sect, keys in watched.items():
            for k, vals in u.get(sect, {}).items():
                if k not in keys: continue
                if k in ("Wants", "After") and not any(ONLINE in v.split() for v in vals): continue   # only the network one is ours
                hit.append(f"{k}=")
        if hit: why.append(f"the drop-in {unit}.d/{n} also sets {', '.join(sorted(hit))}")
    return [f"{unit}.d/{n}" for n in names], "; ".join(why)

def load_task(timer, status=None):
    """Build a task from a timer file (and the service it starts). "full" means the editor can rewrite it."""
    u = read_unit(unit_path(timer))
    if u is None: return None
    tk, base = u.get("Timer", {}), timer[:-6]
    target = (tk.get("Unit") or [base + ".service"])[0]
    files, why = dropin_info(timer, TIMER_DROPIN_KEYS)
    sched = None if why else parse_schedule(tk)         # a drop-in that changes the schedule: the file isn't the whole truth
    desc = unesc((u.get("Unit", {}).get("Description") or [""])[0])
    m = {"timer": timer, "unit": base, "service": target, "name": desc or base, "kind": "service", "full": False,
         "trigger": sched[0] if sched else None, "catchup": sched[1] if sched else True,
         "adv": {"delay": sched[2] if sched else 0}, "dropins": files,
         # "enabled" means the timer is active (will fire); "fstate" says whether it also survives a restart
         "enabled": (status[timer].get("ActiveState") == "active" if status is not None and timer in status
                     else unit_status(timer)[1]),
         "fstate": status[timer].get("UnitFileState", "") if status is not None and timer in status else ""}
    if why: m["why"] = why
    if not sched: return m
    if target == base + ".service" and os.path.isfile(f"{UNITS}/{target}"):
        sfiles, swhy = dropin_info(target, SERVICE_DROPIN_KEYS)
        m["dropins"] = files + sfiles
        s = parse_service(target)
        if swhy or "why" in s: m["why"] = swhy or s["why"]; return m
        m.update(kind=s["kind"], app=s.get("app", ""), command=s.get("command", ""),
                 adv={**s["adv"], "delay": sched[2]})
    m["full"] = True
    return m

def user_timers():
    try: files = sorted(os.listdir(UNITS))
    except OSError: return []
    return [n for n in files if n.endswith(".timer") and "@." not in n and os.path.isfile(f"{UNITS}/{n}")]

def timer_target(timer):
    u = read_unit(unit_path(timer)) or {}
    return (u.get("Timer", {}).get("Unit") or [timer[:-6] + ".service"])[0]

def unscheduled_services(timers):
    """Services in the user unit folder that no timer triggers."""
    used = {timer_target(t) for t in timers}
    try: files = sorted(os.listdir(UNITS))
    except OSError: return []
    return [n for n in files if n.endswith(".service") and "@." not in n and n not in used
            and os.path.isfile(f"{UNITS}/{n}")]

def list_services():
    """Names of the user's existing service units (not templates, not masked).
    Merges what systemd reports with the unit folders, so one source missing a unit doesn't hide it."""
    names = set()
    def add(n):
        if n.endswith(".service") and "@." not in n: names.add(n)
    for cmd in (("list-unit-files", "--type=service"), ("list-units", "--type=service", "--all")):
        for l in ctl(*cmd, "--no-legend", "--no-pager").stdout.splitlines():
            parts = l.replace("●", " ").replace("*", " ").split()
            if parts: add(parts[0])
    dirs = [UNITS, f"{APPS}/systemd/user", "/etc/systemd/user", "/usr/local/lib/systemd/user", "/usr/lib/systemd/user"]
    dirs += [f"{d}/systemd/user" for d in os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":") if d]
    for d in dirs:
        try: entries = os.listdir(d)
        except OSError: continue
        for n in entries:
            p = f"{d}/{n}"
            if os.path.isdir(p) and not os.path.islink(p): continue
            if os.path.realpath(p) == "/dev/null": continue      # masked
            add(n)
    return sorted(names)

def unique_base(name):
    """A unit name derived from the task name that clashes with no existing file or service."""
    stem = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "task"
    taken = set(list_services())
    base, i = stem, 2
    while (f"{base}.service" in taken or any(os.path.exists(f"{UNITS}/{base}{e}") for e in (".service", ".timer"))):
        base = f"{stem}-{i}"; i += 1
    return base


# ---------------------------------------------------------------- writing units
def unit_texts(t, old_service="", old_timer=""):
    """(service text or None, timer text). A task that triggers an existing service has no service of its own.
    The old file texts are merged, so lines the editor doesn't manage (ExecCondition=, comments, ...) survive.
    t["old_name"] == name leaves Description= alone; t["keep_exec"] leaves ExecStart= exactly as written.
    Raises ValueError if the command or app can't be turned into an ExecStart."""
    name, tr, adv = t["name"].replace("\n", " "), t["trigger"], t.get("adv", {})
    desc = t.get("old_name") != name
    never = lambda k, v: False
    service = None
    if t["kind"] != "service":
        keep_exec = bool(t.get("keep_exec") and old_service)
        unit = [f"Description={esc(name)}"] if desc else []
        if adv.get("ac"): unit.append("ConditionACPower=true")
        if adv.get("online"): unit += [f"Wants={ONLINE}", f"After={ONLINE}"]
        if adv.get("path"): unit.append(f"ConditionPathExists={esc(adv['path'])}")
        if adv.get("then"): unit.append(f"OnSuccess={adv['then']}")
        if adv.get("fail"): unit.append(f"OnFailure={adv['fail']}")
        retries = int(adv.get("retries") or 0)
        wait = max(1, int(adv.get("retry_wait") or 5))
        if retries: unit += [f"StartLimitIntervalSec={retry_window(retries, wait, adv.get('timeout') or 0)}",
                             f"StartLimitBurst={retries + 1}"]
        low = bool(adv.get("low"))
        svc = [] if old_service else ["Type=oneshot"]
        if adv.get("cwd"): svc.append(f"WorkingDirectory={esc(adv['cwd'])}")
        for kv in shlex.split(adv.get("env", "")): svc.append(f"Environment={shlex.quote(esc(kv))}")   # no $ expansion here
        if adv.get("timeout"): svc.append(f"TimeoutStartSec={int(adv['timeout'])}min")
        if retries: svc += ["Restart=on-failure", f"RestartSec={wait}min"]
        if low: svc += ["Nice=19", "IOSchedulingClass=idle"]
        if t["kind"] == "app": svc.append("KillMode=process")    # the launcher exits at once: don't kill the app it started
        if not keep_exec: svc.append(f"ExecStart={build_exec(t)}")
        def keep_svc(k, v):                # a Nice= or IOSchedulingClass= that isn't the low-priority preset stays
            return not low and ((k == "Nice" and v != "19") or (k == "IOSchedulingClass" and v != "idle"))
        def keep_unit(k, v):               # keep dependencies and conditions that aren't ours
            if k == "ConditionACPower": return v != "true"
            if k in ("Wants", "After"): return set(v.split()) != {ONLINE}
            return False
        service = merge_unit(old_service, {
            "Unit": (UNIT_KEYS | ({"Description"} if desc else set()), unit, keep_unit),
            "Service": (SERVICE_KEYS | (set() if keep_exec else {"ExecStart"})
                        | ({"KillMode"} if t["kind"] == "app" else set()),
                        svc, keep_svc)})
    timer = merge_unit(old_timer, {
        "Unit": ({"Description"} if desc else set(), [f"Description={esc(name)}"] if desc else [], never),
        "Timer": (TIMER_KEYS | {"Unit"},
                  ([f"Unit={t['service']}"] if t["kind"] == "service" else [])
                  + timer_lines(tr, t.get("catchup", True), adv.get("delay", 0)), timer_keep(tr)),
        "Install": ({"WantedBy"}, ["WantedBy=timers.target"], lambda k, v: v != "timers.target")})
    return service, timer

def apply_task(t):
    """Write the units for a task and (de)activate its timer. Returns an error text or None."""
    base = f"{UNITS}/{t['unit']}"
    service, timer = unit_texts(t, read_text(base + ".service"), read_text(base + ".timer"))
    try:
        os.makedirs(UNITS, exist_ok=True)
        for ext, text in ((".service", service), (".timer", timer)):
            if text is None:                   # the task was switched to an existing service: keep a backup
                if os.path.exists(base + ext):
                    try: os.replace(base + ext, base + ext + ".reveille-bak")
                    except OSError: pass
                continue
            write_atomic(base + ext, text)
    except OSError as e:
        return f"Could not write the unit files: {e.strerror or e}"
    ctl("daemon-reload")
    unit = f"{t['unit']}.timer"
    r = ctl("enable", "--now", unit) if t.get("enabled", True) else ctl("disable", "--now", unit)
    return r.stderr.strip() if r.returncode else None

def delete_plan(name):
    """The unit files that deleting `name` (a timer or a service without a timer) removes, as names in the
    user unit folder. A timer takes its same-named service along, unless another timer still triggers it."""
    names = [name]
    if name.endswith(".timer"):
        svc = name[:-6] + ".service"
        if timer_target(name) == svc and not any(timer_target(t) == svc for t in user_timers() if t != name):
            names.append(svc)
    def is_unit_file(n):
        p = f"{UNITS}/{n}"
        return os.path.islink(p) or os.path.isfile(p)
    return [n for n in names if is_unit_file(n)]

def remove_units(names):
    """Stop timers and delete the files (a symlink is removed as a link). Returns a snapshot for restore_units."""
    snap = {"items": [], "enable": [], "failed": []}
    for n in names:
        p = f"{UNITS}/{n}"
        if n.endswith(".timer"):
            if unit_status(n)[1]: snap["enable"].append(n)
            ctl("disable", "--now", n)
        try:
            if os.path.islink(p):
                snap["items"].append(("link", p, os.readlink(p)))
            else:
                with open(p, "rb") as f: snap["items"].append(("file", p, f.read()))
            os.unlink(p)
        except OSError:
            snap["items"] = [i for i in snap["items"] if i[1] != p]; snap["failed"].append(n)
    ctl("daemon-reload")
    return snap

def restore_units(snap):
    os.makedirs(UNITS, exist_ok=True)
    for kind, p, payload in snap["items"]:
        try:
            if os.path.lexists(p): continue            # something new took its place meanwhile: don't overwrite it
            if kind == "link": os.symlink(payload, p)
            else:
                with open(p, "wb") as f: f.write(payload)
        except OSError: pass
    ctl("daemon-reload")
    for n in snap["enable"]: ctl("enable", "--now", n)

def set_timer(name, on):
    """Turn a timer on (enable and start) or off (disable and stop). A hand-written timer without an [Install]
    section can't be enabled, so plain start/stop is the fallback. Returns an error text or None."""
    r = ctl("enable" if on else "disable", "--now", name)
    err = r.stderr.strip() if r.returncode else ""
    if r.returncode or unit_status(name)[1] != on:
        r2 = ctl("start" if on else "stop", name)
        if r2.returncode: return r2.stderr.strip() or err or "systemctl failed"
        if unit_status(name)[1] != on: return err or "The timer did not change state"
    return None

def start_service(service):
    """Queue a service to run now. Returns an error text or None."""
    r = ctl("start", "--no-block", service)
    return (r.stderr.strip() or "systemctl failed") if r.returncode else None

def start_now(m):
    return start_service(m["service"])

def bad_calendar(expr):
    """True if `expr` (one or several calendar expressions separated by |) is empty or rejected by
    systemd-analyze. If systemd-analyze is missing or too slow nothing can be checked, so it is not rejected."""
    parts = calendar_parts(expr)
    if not parts: return True
    for p in parts:
        r = sh("systemd-analyze", "calendar", p, timeout=5)
        if r is not None and r.returncode: return True
    return False

def pick_list(items, current):
    """(items, index) for a picker. A current value the list doesn't offer (an uninstalled app, a hidden
    service) is added at the top and selected, so saving without touching it can't silently switch it."""
    items = list(items)
    if current and current in items: return items, items.index(current)
    if current: items.insert(0, current); return items, 0
    return items, 0


def sh(*cmd, timeout=10):
    """Run a program; None if it is missing or too slow."""
    try: return subprocess.run(list(cmd), capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired): return None

def linger_state():
    """Whether systemd keeps this user's session (and so its timers) running while logged out:
    True, False, or None if it can't be told."""
    r = sh("loginctl", "show-user", str(os.getuid()), "-p", "Linger")
    m = re.search(r"^Linger=(\w+)", r.stdout, re.M) if r and r.returncode == 0 else None
    return m[1] == "yes" if m else None

def set_linger(on):
    """Turn lingering on or off for the current user. Returns an error text or None."""
    r = sh("loginctl", "enable-linger" if on else "disable-linger", timeout=30)
    if r is None: return "loginctl is not available"
    return (r.stderr.strip() or "loginctl failed") if r.returncode else None

LOG_HINT = ("No log entries for this service yet.\n\nIf it has run before, your system may not keep a per-user "
            "journal. Try: journalctl --user -u {unit}")

def read_log(service, lines=200):
    """The last lines of a service's journal: (text, None), or ("", error text)."""
    r = sh("journalctl", "--user", f"--unit={service}", "-n", str(int(lines)), "--no-pager", "-o", "short-iso",
           timeout=15)
    if r is None: return "", "journalctl is not available or took too long"
    if r.returncode: return "", r.stderr.strip() or "journalctl failed"
    text = r.stdout.strip()
    return (text, None) if text and not text.startswith("-- No entries") else (LOG_HINT.format(unit=service), None)

_CACHE = {}

def systemd_version():
    """The running systemd's major version (255, say), or None if it can't be told. Asked once."""
    if "v" not in _CACHE:
        r = sh("systemctl", "--version", timeout=5)
        m = re.match(r"systemd (\d+)", r.stdout) if r and r.returncode == 0 else None
        _CACHE["v"] = int(m[1]) if m else None
    return _CACHE["v"]

class FollowLog:
    """`journalctl -f` for a service. Lines are read in a thread and handed to on_line(text), which therefore
    runs off the main thread. start() returns an error text or None; stop() ends the follow."""
    def __init__(self, service, on_line, lines=200):
        self.service, self.on_line, self.lines = service, on_line, lines
        self.proc, self.stopped = None, False

    def start(self):
        try:
            self.proc = subprocess.Popen(
                ["journalctl", "--user", f"--unit={self.service}", "-n", str(int(self.lines)), "-f", "--no-pager",
                 "-o", "short-iso"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
        except OSError:
            return "journalctl is not available"
        threading.Thread(target=self._read, daemon=True).start()
        return None

    def _read(self):
        proc = self.proc
        for line in proc.stdout:
            if self.stopped: break
            line = line.rstrip("\n")
            if not line.startswith("-- "): self.on_line(line)          # "-- No entries --" and friends
        proc.stdout.close(); proc.wait()

    def stop(self):
        self.stopped = True
        if self.proc and self.proc.poll() is None: self.proc.terminate()

def task_texts(m):
    """(subtitle, tooltip) of a task row, from what gather() collected."""
    lines = [describe(m["trigger"]) if m["trigger"] else "Custom schedule"]
    if m["enabled"]:
        lines.append("Next: " + (m["next_text"] or "when triggered"))
        if m["fstate"] and m["fstate"] not in BOOT_OK: lines.append("Not enabled: won't start again after a restart")
    else:
        lines.append("Stopped, starts again at next login" if m["fstate"] in BOOT_OK else "Disabled")
    last, status = m["last"], []
    if m.get("retrying"): status.append("Waiting to retry")
    elif m["running"]: status.append("Running now")
    if last: status.append(f"Last: {m['last_text']} " + ("OK" if last["rc"] == 0 else f"failed ({last['rc']})"))
    if status: lines.append(" · ".join(status))
    tip = [f"Next: {m['next']}" if m["enabled"] and m["next"] else "", f"Last: {last['time']}" if last else ""]
    return "\n".join(lines), "\n".join(x for x in tip if x)

def gather():
    """Everything the window lists, fetched with two systemctl calls however many tasks there are.
    The service list for the editor's pickers is not part of it (list_services is the costly one): the window
    fetches it when an editor opens. No GTK in here, so it can run off the main thread."""
    timers = user_timers()
    st = show_many(timers, "ActiveState", "UnitFileState", "NextElapseUSecRealtime", "NextElapseUSecMonotonic")
    tasks = [m for m in (load_task(t, st) for t in timers) if m]
    sv = show_many(sorted({m["service"] for m in tasks}), "ActiveState", "SubState", "Result", "ExecMainStatus",
                   "ExecMainExitTimestamp")
    now, mono = time.time(), time.monotonic()
    for m in tasks:
        kv, svc = st.get(m["timer"], {}), sv.get(m["service"], {})
        m["next"] = kv.get("NextElapseUSecRealtime", "").strip()
        ep = next_run_epoch(kv, now, mono)
        m["next_text"] = ("any moment" if ep <= now else relative(ep, now)) if ep else ""
        m["last"] = last_run_from(svc)
        lt = parse_ts(m["last"]["time"]) if m["last"] else None
        m["last_text"] = relative(lt, now) if lt else (m["last"] or {}).get("time", "")
        m["retrying"] = svc.get("SubState") == "auto-restart"          # failed, waiting for the next try
        m["running"] = svc.get("ActiveState") in ("activating", "active") and not m["retrying"]
    tasks.sort(key=lambda m: m["name"].lower())
    return {"tasks": tasks, "free": unscheduled_services(timers), "linger": linger_state(),
            "systemd": systemd_version()}


# ---------------------------------------------------------------- crontab
CRON_FIELDS = (("minute", 0, 59, {}), ("hour", 0, 23, {}), ("day of month", 1, 31, {}),
               ("month", 1, 12, {m: i for i, m in enumerate("jan feb mar apr may jun jul aug sep oct nov dec".split(), 1)}),
               ("day of week", 0, 7, {d: i for i, d in enumerate("sun mon tue wed thu fri sat".split())}))
CRON_MACROS = {"@yearly": "*-01-01 00:00:00", "@annually": "*-01-01 00:00:00", "@monthly": "*-*-01 00:00:00",
               "@weekly": "Sun *-*-* 00:00:00",            # systemd's own "weekly" is Monday, cron's is Sunday
               "@daily": "*-*-* 00:00:00", "@midnight": "*-*-* 00:00:00", "@hourly": "*-*-* *:00:00"}
CRON_NO_ENV = {"MAILTO", "MAILFROM", "SHELL", "CRON_TZ", "LOGNAME"}      # cron settings, not variables for the command
CRON_NOISE = re.compile(r"m\s+h\s+dom|DO NOT EDIT|\(.* installed on|\(Cron version", re.I)   # comments crontab adds itself
CRON_BUILTINS = {"cd", "export", "exit", "source", ".", "exec", "set", "unset", "umask", "ulimit", "alias", "eval",
                 "read", "trap", "wait"}

def cron_field(text, lo, hi, names, label):
    """The values one cron field selects, as a set. Raises ValueError saying what is wrong."""
    def val(x, item):
        if x.isdigit(): return int(x)
        if x.lower() in names: return names[x.lower()]
        raise ValueError(f"{label}: {item!r} is not understood")
    out = set()
    for item in text.split(","):
        rng, slash, step = item.partition("/")
        if slash:
            if not step.isdigit() or int(step) < 1: raise ValueError(f"{label}: bad step in {item!r}")
            if rng != "*" and "-" not in rng:
                raise ValueError(f"{label}: {item!r} means different things to different crons; write */N or A-B/N")
        if rng == "*": a, b = lo, hi
        elif "-" in rng:
            p, _, q = rng.partition("-"); a, b = val(p, item), val(q, item)
        else: a = b = val(rng, item)
        if not lo <= a <= b <= hi: raise ValueError(f"{label}: {item!r} is out of range ({lo} to {hi})")
        out |= set(range(a, b + 1, int(step) if slash else 1))
    return out

def cron_list(vals, lo, hi, lab, steps=0):
    """A set as systemd writes it: * for all, A/N for an even run from the start, A..B for 3 or more in a row,
    else a comma list. `steps` is the fewest values worth writing as A/N (0: never)."""
    vals = sorted(vals)
    if vals == list(range(lo, hi + 1)): return "*"
    st = vals[1] - vals[0] if len(vals) > 1 else 0
    if steps and len(vals) >= steps and 2 <= st > vals[0] and vals == list(range(vals[0], hi + 1, st)):
        return f"{vals[0]}/{st}"
    out, i = [], 0
    while i < len(vals):
        j = i
        while j + 1 < len(vals) and vals[j + 1] == vals[j] + 1: j += 1
        out += [f"{lab(vals[i])}..{lab(vals[j])}"] if j - i >= 2 else [lab(v) for v in vals[i:j + 1]]
        i = j + 1
    return ",".join(out)

def cron_schedule(spec):
    """(trigger, warnings) for the five schedule fields of a cron line, or an @macro. Raises ValueError.
    Cron fires on the wall clock, so even "*/15" is a calendar expression here, never an interval."""
    if spec.startswith("@"):
        if spec == "@reboot":
            return {"type": "login", "login_sec": 10}, ["@reboot becomes 'At login': it runs when your session starts, "
                                                      "not when the machine boots (turn on lingering for that)"]
        if spec not in CRON_MACROS: raise ValueError(f"{spec} is not a cron schedule")
        return from_calendar(CRON_MACROS[spec]), []
    parts = spec.split()
    if len(parts) != 5: raise ValueError("a cron line needs five schedule fields")
    minute, hour, dom, mon, dow = (cron_field(p, lo, hi, names, label) for p, (label, lo, hi, names) in zip(parts, CRON_FIELDS))
    dow = {d % 7 for d in dow}                              # 0 and 7 are both Sunday
    # cron: if day of month and weekday both start with a digit or name, a day matches either; otherwise both must
    either = not parts[2].startswith("*") and not parts[4].startswith("*")
    if either and (len(dom) == 31 or len(dow) == 7): dom, dow = set(range(1, 32)), set(range(7))   # "either" with "any day"
    two = either and len(dom) < 31 and len(dow) < 7
    pad = "{:02d}".format
    time = f"{cron_list(hour, 0, 23, pad, 5)}:{cron_list(minute, 0, 59, pad, 3)}:00"
    days = cron_list([(d - 1) % 7 for d in dow], 0, 6, DAYS.__getitem__)       # Monday is 0 here
    d, m = cron_list(dom, 1, 31, pad, 3), cron_list(mon, 1, 12, pad, 3)
    if two:
        exprs = [f"{days} *-{m}-* {time}", f"*-{m}-{d} {time}"]
        warn = ["day of month and weekday are both set, so cron runs on either; written as two schedules"]
    else:
        exprs, warn = [f"{days + ' ' if days != '*' else ''}*-{m}-{d} {time}"], []
    return (from_calendar(exprs[0]) if len(exprs) == 1 else {"type": "custom", "expr": " | ".join(exprs)}), warn

def parse_crontab(text):
    """The entries of a crontab as dicts: line, raw, hint (the comment just above), env (the VAR=value lines above it),
    and spec + command, or error for a line that isn't an entry. Comments and blank lines are skipped."""
    env, hint, out = {}, "", []
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line: hint = ""; continue
        if line.startswith("#"):
            c = line.lstrip("#").strip()
            hint = "" if CRON_NOISE.search(c) or re.match(r"[\d*@]", c) else c
            continue
        m = re.fullmatch(r"([A-Za-z_]\w*)\s*=\s*(.*)", line)
        if m:
            v = m[2].strip()
            env[m[1]] = v[1:-1] if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'" else v
            hint = ""; continue
        macro = line.startswith("@")
        parts = line.split(None, 1 if macro else 5)
        item = {"line": n, "raw": line, "hint": hint, "env": dict(env)}
        if len(parts) < (2 if macro else 6): item["error"] = "not a valid cron line"
        else: item["spec"], item["command"] = " ".join(parts[:-1]), parts[-1].strip()
        out.append(item); hint = ""
    return out

def cron_task_command(cmd, shell="/bin/sh"):
    """The command as the editor holds it. cron hands every line to a shell; a unit runs its command directly, so
    anything that needs a shell (pipes, redirects, variables, quotes, cd) is wrapped in `SHELL -c '...'`."""
    cmd = cmd.replace("\\%", "%")
    first = cmd.split()[0]
    plain = (re.fullmatch(r"[\w@+:,./-]+(?: [\w@+=:,./-]+)*", cmd) and first not in CRON_BUILTINS
             and (first.startswith("/") or "/" not in first))
    return cmd if plain else f"{shell} -c {shlex.quote(cmd)}"

def cron_name(e, cmd):
    words = [w for w in cmd.split() if not re.match(r"\w+=", w)]
    base = os.path.basename(words[0]) if words and words[0] not in CRON_BUILTINS else ""
    return e["hint"] or base or f"Cron job (line {e['line']})"

def existing_cron_keys():
    """(command, schedule) of every command task already there, to tell what an import would duplicate."""
    keys = set()
    for t in user_timers():
        m = load_task(t)
        if m and m.get("full") and m["kind"] == "command" and m["trigger"]:
            keys.add((m["command"], on_calendar(m["trigger"]) or m["trigger"]["type"]))
    return keys

def crontab_plan(text, known=None):
    """What importing a crontab would do, one dict per entry: line, raw, name, schedule (in words), warnings, task,
    general (notes about the whole file, such as MAILTO, which are shown once), next (when a new task would run next),
    and status: "new", "duplicate" (a task with the same command and schedule exists) or "skip" (reason says why).
    Writes nothing. A task is only planned if its command can be run and systemd accepts its schedule."""
    known = existing_cron_keys() if known is None else known
    plan = []
    for e in parse_crontab(text):
        it = {"line": e["line"], "raw": e["raw"], "status": "skip", "reason": "", "warnings": [], "general": [], "next": "", "name": "",
              "schedule": "", "task": None}
        plan.append(it)
        if "error" in e: it["reason"] = e["error"]; continue
        try: tr, it["warnings"] = cron_schedule(e["spec"])
        except ValueError as x: it["reason"] = str(x); continue
        if re.search(r"(?<!\\)%", e["command"]):
            it["reason"] = "the command has a bare %, which cron turns into a newline and input; write \\% or rewrite it"
            continue
        env = e["env"]
        shell = env["SHELL"] if os.path.isabs(env.get("SHELL", "")) else "/bin/sh"
        if env.get("MAILTO"): it["general"].append("MAILTO is not carried over: output goes to the journal "
                                                   "(use 'If it fails, run' to get notified)")
        if env.get("CRON_TZ"): it["general"].append("CRON_TZ is not applied: times follow the system time zone")
        cmd = cron_task_command(e["command"], shell)
        t = {"name": cron_name(e, e["command"]), "kind": "command", "command": cmd, "trigger": tr, "catchup": False,
             "enabled": True, "adv": {"delay": 0, "env": " ".join(shlex.quote(f"{k}={v}") for k, v in env.items()
                                                                   if k not in CRON_NO_ENV)}}
        it["name"], it["schedule"] = t["name"], describe(tr)
        try: run = xunesc(build_exec(t))
        except ValueError as x: it["reason"] = str(x); continue
        cal = on_calendar(tr)
        if cal and bad_calendar(cal): it["reason"] = f"systemd rejected the converted schedule ({cal})"; continue
        key = (run, cal or tr["type"])
        it["task"], it["status"] = t, "duplicate" if key in known else "new"
        if key in known: it["reason"] = "a task with this command and schedule already exists"
        if it["status"] == "new": it["next"] = next_elapse(tr).splitlines()[0]
        known.add(key)
    return plan

def cron_notes(plan):
    """Notes about the whole crontab (MAILTO, CRON_TZ), each once."""
    return sorted({g for it in plan for g in it["general"]})

def cron_row_texts(it):
    """(title, subtitle) of one entry for a list: what will happen to it, the original line, then any warnings."""
    first = {"new": f"{it['schedule']} · next {it['next']}",
             "duplicate": "Already a task with this command and schedule",
             "skip": f"Can't import: {it['reason']}"}[it["status"]]
    return it["name"] or f"Line {it['line']}", "\n".join([first, f"cron: {it['raw']}"] + [f"• {w}" for w in it["warnings"]])

def crontab_report(plan):
    """The plan as text for the command line."""
    out = []
    for it in plan:
        label = {"new": "will import", "duplicate": "already imported", "skip": "can't import"}[it["status"]]
        out.append(f"Line {it['line']}: {it['name'] or it['raw']}  [{label}]")
        out.append(f"  cron      {it['raw']}")
        if it["status"] != "skip":
            out.append(f"  schedule  {it['schedule']}")
            if it["status"] == "new": out.append(f"  next      {it['next']}")
        if it["reason"]: out.append(f"  {'why' if it['status'] == 'skip' else 'note'}       {it['reason']}")
        out += [f"  note      {w}" for w in it["warnings"]]
        out.append("")
    return "\n".join(out + [f"Note: {g}" for g in cron_notes(plan)]).rstrip()

def import_summary(results, enabled):
    """One line for a toast: what import_crontab did."""
    bad = [err for _it, _unit, err in results if err]
    n = len(results) - len(bad)
    msg = f"Imported {n} task{'' if n == 1 else 's'}" + ("" if enabled else " (switched off)")
    return msg + (f"; {len(bad)} had a problem: {bad[0]}" if bad else "")

def import_crontab(plan, enabled=True):
    """Create the planned tasks. Returns [(entry, unit name, error text or None)]. Each unit name is picked just before
    its task is written, so two entries with the same name can't collide."""
    done = []
    for it in plan:
        if it["status"] != "new": continue
        t = {**it["task"], "unit": unique_base(it["task"]["name"]), "enabled": enabled}
        try: err = apply_task(t)
        except ValueError as x: err = str(x)
        done.append((it, t["unit"], err))
    return done

def read_crontab(path=None):
    """(text, None) from a file ("-" is standard input) or from `crontab -l`; ("", error text) if that fails.
    A user without a crontab gives ("", None)."""
    if path:
        try:
            if path == "-": return sys.stdin.read(), None
            with open(path, encoding="utf-8", errors="replace") as f: return f.read(), None
        except OSError as e: return "", f"Could not read {path}: {e.strerror or e}"
    r = sh("crontab", "-l")
    if r is None: return "", "crontab is not available here (--file reads a saved one)"
    if r.returncode:
        return ("", None) if "no crontab" in r.stderr.lower() else ("", r.stderr.strip() or "crontab -l failed")
    return r.stdout, None
# ---------------------------------------------------------------- app menu
def menu_installed():
    return os.path.isfile(DESKTOP)

def refresh_desktop_db():
    try: subprocess.run(["update-desktop-database", os.path.dirname(DESKTOP)], capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired): pass

def install_menu():
    """Copy the program to a stable place and add an entry to the app menu. Returns an error text or None."""
    try:
        os.makedirs(os.path.dirname(INSTALLED), exist_ok=True)
        if os.path.realpath(SELF) != os.path.realpath(INSTALLED):
            shutil.copyfile(SELF, INSTALLED + ".tmp"); os.chmod(INSTALLED + ".tmp", 0o755)
            os.replace(INSTALLED + ".tmp", INSTALLED)
        os.makedirs(os.path.dirname(DESKTOP), exist_ok=True)
        cmd = f'"{sys.executable}" "{INSTALLED}"'
        with open(DESKTOP, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Task Scheduler\n"
                    "Comment=Run apps and commands on a schedule\n"
                    f"Exec={cmd}\nIcon=preferences-system-time\nTerminal=false\n"
                    "Categories=Utility;System;\nKeywords=schedule;timer;cron;task;\n")
    except OSError as e:
        return e.strerror or str(e)
    refresh_desktop_db()
    return None

def uninstall_menu():
    for p in (DESKTOP, INSTALLED):
        try: os.unlink(p)
        except OSError: pass
    refresh_desktop_db()


